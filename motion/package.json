{
  "name": "lottie-generative-icons-authoring",
  "version": "1.0.0",
  "description": "Authoring sources, preflight and native export tooling for Generative Animated Icons",
  "scripts": {
    "build:icons": "node icon-sets/01-heart-bell/build.mjs",
    "verify:icons": "node icon-sets/01-heart-bell/verify.mjs",
    "test:icons": "npm run test:library",
    "build:search": "node icon-sets/02-search/build.mjs",
    "verify:search": "node icon-sets/02-search/verify.mjs",
    "test:search": "npm run test:library",
    "build:essentials": "node icon-sets/03-essentials/build.mjs",
    "verify:essentials": "node icon-sets/03-essentials/verify.mjs",
    "test:essentials": "node --test icon-sets/03-essentials/controller.test.mjs",
    "test:library": "node --test icon-sets/library/controller.test.mjs icon-sets/03-essentials/controller.test.mjs",
    "package:library": "python3 icon-sets/library/package.py",
    "verify:paint": "node icon-sets/library/verify-paint.mjs",
    "build:actions": "node icon-sets/04-actions/build.mjs",
    "verify:actions": "node icon-sets/04-actions/verify.mjs",
    "build:interface": "node icon-sets/05-interface/build.mjs",
    "verify:interface": "node icon-sets/05-interface/verify.mjs",
    "build:tools": "node icon-sets/06-tools/build.mjs",
    "verify:tools": "node icon-sets/06-tools/verify.mjs",
    "build:ai": "node icon-sets/library/run-ai.mjs build",
    "verify:ai": "node icon-sets/library/run-ai.mjs verify",
    "package:ai": "python3 icon-sets/library/package-ai.py",
    "build:feedback": "node icon-sets/11-feedback-status/build.mjs",
    "verify:feedback": "node icon-sets/11-feedback-status/verify.mjs",
    "build:loaders": "node icon-sets/12-loading-indicators/build.mjs",
    "verify:loaders": "node icon-sets/12-loading-indicators/verify.mjs",
    "build:finance": "node icon-sets/13-fintech-finance/build.mjs",
    "verify:finance": "node icon-sets/13-fintech-finance/verify.mjs && node icon-sets/13-fintech-finance/verify-clearance.mjs",
    "build:travel": "node icon-sets/14-travel/build.mjs",
    "verify:travel": "node icon-sets/14-travel/verify.mjs && node icon-sets/14-travel/verify-clearance.mjs",
    "build:commerce": "node icon-sets/15-commerce-delivery/build.mjs",
    "verify:commerce": "node icon-sets/15-commerce-delivery/verify.mjs && node icon-sets/15-commerce-delivery/verify-clearance.mjs",
    "icons:context": "node icon-sets/library/generation-context.mjs",
    "icons:preflight": "node icon-sets/library/preflight.mjs",
    "build:checked": "node icon-sets/library/build-checked.mjs",
    "test:harness": "node --test icon-sets/library/generation-harness.test.mjs",
    "build:voice": "node icon-sets/library/build-checked.mjs icon-sets/16-voice",
    "verify:voice": "node icon-sets/16-voice/verify.mjs && node icon-sets/16-voice/verify-clearance.mjs",
    "build:media": "node icon-sets/library/build-checked.mjs icon-sets/17-media-playback",
    "verify:media": "node icon-sets/17-media-playback/verify.mjs && node icon-sets/17-media-playback/verify-clearance.mjs",
    "build:motion-design": "node icon-sets/library/build-checked.mjs icon-sets/18-motion-design",
    "verify:motion-design": "node icon-sets/18-motion-design/verify.mjs && node icon-sets/18-motion-design/verify-clearance.mjs",
    "build:agent-operations": "node icon-sets/library/build-checked.mjs icon-sets/19-agent-operations",
    "verify:agent-operations": "node icon-sets/19-agent-operations/verify.mjs && node icon-sets/19-agent-operations/verify-clearance.mjs",
    "build:arrows": "node icon-sets/library/build-checked.mjs icon-sets/20-arrows",
    "verify:arrows": "node icon-sets/20-arrows/verify.mjs && node icon-sets/20-arrows/verify-clearance.mjs",
    "build:annotation-arrows": "node icon-sets/library/build-checked.mjs icon-sets/21-annotation-arrows",
    "verify:annotation-arrows": "node icon-sets/21-annotation-arrows/verify.mjs && node icon-sets/21-annotation-arrows/verify-clearance.mjs",
    "build:teamwork": "node icon-sets/library/build-checked.mjs icon-sets/22-teamwork",
    "verify:teamwork": "node icon-sets/22-teamwork/verify.mjs && node icon-sets/22-teamwork/verify-clearance.mjs",
    "build:get-help": "node icon-sets/library/build-checked.mjs icon-sets/23-get-help",
    "verify:get-help": "node icon-sets/23-get-help/verify.mjs && node icon-sets/23-get-help/verify-clearance.mjs",
    "build:file-transfer": "node icon-sets/library/build-checked.mjs icon-sets/24-file-transfer",
    "verify:file-transfer": "node icon-sets/24-file-transfer/verify.mjs && node icon-sets/24-file-transfer/verify-clearance.mjs",
    "build:infrastructure": "node icon-sets/library/build-checked.mjs icon-sets/32-infrastructure-devices",
    "verify:infrastructure": "node icon-sets/32-infrastructure-devices/verify.mjs && node icon-sets/32-infrastructure-devices/verify-clearance.mjs",
    "build:communication": "node icon-sets/library/build-checked.mjs icon-sets/33-communication-social",
    "verify:communication": "node icon-sets/33-communication-social/verify.mjs && node icon-sets/33-communication-social/verify-clearance.mjs",
    "build:scheduling": "node icon-sets/library/build-checked.mjs icon-sets/34-scheduling-time",
    "verify:scheduling": "node icon-sets/34-scheduling-time/verify.mjs && node icon-sets/34-scheduling-time/verify-clearance.mjs"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@lottiefiles/dotlottie-web": "0.80.0",
    "linkedom": "0.18.12",
    "opentype.js": "1.3.4",
    "svgpath": "2.6.0"
  },
  "private": true
}
