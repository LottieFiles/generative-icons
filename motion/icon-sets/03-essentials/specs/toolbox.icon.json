    },
    "lid-rig.rotate": {
      "light": [[0, 0], [0.13, -5, "out"], [0.2, -5], [0.29, 0, "hit"]],
      "strong": [[0, 0], [0.05, -1.5, "out"], [0.09, 0, "hit"], [0.14, -1.5, "out"], [0.18, 0, "hit"], [0.31, -7, "out"], [0.37, -7], [0.46, 0, "hit"]]
    },
