{
  "$schema": "https://gen-animated-icons.lottiefiles.com/schema/icon-v2.json",
  "format": "gai-icon/2",
  "id": "credit-card",
  "label": "Credit card",
  "intent": "Tap to pay. Light: the rigid card dips onto the reader and holds the tap; two contactless waves draw on above it from the centre outward, inner then outer, and fade before the card lifts back with a small overshoot. Strong: a firmer tap that bounces once on contact and holds while the waves signal twice, then a clear rebound on release. The reader never moves.",
  "parts": {
    "reader":  {"shape": {"line": [[10, 27.5], [22, 27.5]]}},
    "card":    {"shape": {"rect": [6, 8.5, 20, 15.5], "r": 2.5}, "role": "surface", "solid": "fill",
                "knockout": [{"part": "stripe", "gap": 0}, {"part": "chip", "gap": 0}]},
    "stripe":  {"shape": {"line": [[6.5, 14], [25.5, 14]]},
                "solid": {"rect": [7, 12.8, 18, 2.2], "r": 1.1}},
    "chip":    {"shape": {"rect": [9, 18.5, 4.5, 2], "r": 1}, "role": "fill"},
    "wave-1":  {"//": "hidden at rest: each wave is two halves in one layer, so both draw out from the top centre and fade as one", "shape": [{"arc": [[16, 13.9], 8.4, -90, -60]}, {"arc": [[16, 13.9], 8.4, -90, -120]}], "hidden": true},
    "wave-2":  {"shape": [{"arc": [[16, 13.9], 11.2, -90, -60]}, {"arc": [[16, 13.9], 11.2, -90, -120]}], "hidden": true}
  },
  "rigs": {
    "card": {"carries": ["stripe", "chip"]}
  },
  "motion": {
    "card.y": {
      "light":  [[0, 0], [0.1, 1.6, "hit"], {"hold": 0.28}, [0.38, -0.35], [0.48, 0]],
      "strong": [[0, 0], [0.1, 2, "hit"], {"bounce": 0.2, "amp": 0.15}, {"hold": 0.5}, [0.6, -0.7], [0.7, 0.2], [0.8, 0]]
    },
    "wave-1.opacity": {
      "light":  [[0, 0], [0.1, 0], [0.12, 1, "out"], [0.21, 1], [0.27, 0]],
      "strong": [[0, 0], [0.1, 0], [0.12, 1, "out"], [0.22, 1], [0.29, 0], [0.3, 0], [0.32, 1, "out"], [0.42, 1], [0.5, 0]]
    },
    "wave-1.draw": {
      "light":  [[0, 1], [0.1, 0, "step"], [0.17, 1, "out"]],
      "strong": [[0, 1], [0.1, 0, "step"], [0.17, 1, "out"], [0.3, 0, "step"], [0.37, 1, "out"]]
    },
    "wave-2.opacity": {"follow": "wave-1.opacity", "lag": 0.07},
    "wave-2.draw": {"follow": "wave-1.draw", "lag": 0.07}
  }
}
