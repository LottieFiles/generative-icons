{
  "$schema": "https://gen-animated-icons.lottiefiles.com/schema/icon-v2.json",
  "format": "gai-icon/2",
  "id": "stopwatch",
  "label": "Stopwatch",
  "intent": "The stopwatch is started and times a lap. Light: the plunger is pressed in with a click and springs back; on the click the sweep hand runs at a steady pace from 12 to 20 seconds, stops dead and ticks back into place; the time stays. Strong: the thumb lifts first and presses harder, the hand runs, and a second press stops it dead; the hand shudders twice and settles. The case never moves. The reset fades the hand back to 12.",
  "state": {"from": "prepared", "to": "result", "labels": ["Play action", "Reset preview"], "reverse": "fade"},
  "parts": {
    "hub": {"shape": {"circle": [[16, 17.5], 1.3]}, "role": "fill"},
    "hand": {"shape": {"line": [[16, 17.5], [16, 12.9]]}},
    "button": {"shape": {"line": [[13.4, 4.4], [18.6, 4.4]]}},
    "stem": {"shape": {"line": [[16, 7], [16, 5.4]]}},
    "tick-9": {"shape": {"line": [[7.6, 17.5], [6.5, 17.5]]}},
    "tick-6": {"shape": {"line": [[16, 25.9], [16, 27]]}},
    "tick-3": {"shape": {"line": [[24.4, 17.5], [25.5, 17.5]]}},
    "case": {"shape": {"circle": [[16, 17.5], 9.5]}, "role": "surface", "solid": "ring"}
  },
  "rigs": {
    "plunger": {"pivot": [16, 5.5], "carries": ["button", "stem"]},
    "hand": {"pivot": [16, 17.5]}
  },
  "reverse": {
    "//": "only the hand changed; the plunger ends at rest, so it stays visible",
    "light": {"button.opacity": [[0, 1], [0.25, 1]], "stem.opacity": [[0, 1], [0.25, 1]]},
    "strong": {"button.opacity": [[0, 1], [0.25, 1]], "stem.opacity": [[0, 1], [0.25, 1]]}
  },
  "motion": {
    "plunger.y": {
      "light": [[0, 0], [0.07, 1.5, "hit"], [0.15, -0.2], [0.22, 0]],
      "strong": [[0, 0], [0.05, -0.4, "out"], [0.11, 1.8, "hit"], [0.18, -0.25], [0.24, 0], [0.33, 0], [0.39, 1.8, "hit"], [0.46, -0.3], [0.53, 0]]
    },
    "hand.rotate": {
      "//": "a running hand: steady (linear) from the click, a dead stop, then only ticks back; it never passes the time",
      "light": [[0, 0], [0.07, 0], [0.36, 120, "linear"], [0.42, 117], [0.48, 120]],
      "strong": [[0, 0], [0.11, 0], [0.39, 120, "linear"], [0.45, 115.5], [0.51, 120, "hit"], [0.56, 118.8], [0.61, 120]]
    }
  }
}
