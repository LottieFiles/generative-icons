{
  "$schema": "https://gen-animated-icons.lottiefiles.com/schema/icon-v2.json",
  "format": "gai-icon/2",
  "id": "overdue",
  "label": "Overdue",
  "intent": "The due time passes and the alert goes up: the item is overdue. Light: the clock's minute hand runs past twelve once round, and as it lands the exclamation mark strikes down beside the clock and its dot pops in. Strong: the hand winds back, runs round hard and stops dead; the mark slams down, the dot pops bigger, and the clock shudders side to side in smaller swings. The mark stays upright.",
  "parts": {
    "dial":   {"shape": {"circle": [[13.5, 17], 8.5]}, "role": "surface", "solid": "ring"},
    "hour":   {"shape": {"line": [[13.5, 17], [17, 17]]}},
    "minute": {"shape": {"line": [[13.5, 17], [13.5, 11.6]]}},
    "bang":   {"shape": {"line": [[26.4, 9.4], [26.4, 19.4]]}},
    "dot":    {"shape": {"circle": [[26.4, 24.4], 1.4]}, "role": "fill"}
  },
  "rigs": {
    "clock":  {"//": "the clock shudders in Strong; the mark stays", "pivot": [13.5, 17], "carries": ["dial", "hour", "minute"]},
    "minute": {"pivot": [13.5, 17]},
    "dot":    {"pivot": [26.4, 24.4]}
  },
  "motion": {
    "minute.rotate": {
      "light":  [[0, 0], [0.3, 360, "inOut"]],
      "strong": [[0, 0], [0.08, -25, "out"], [0.3, 360, "hit"]]
    },
    "bang.draw": {
      "light":  [[0, 1], [0.017, 0, "step"], [0.28, 0], [0.38, 1, "out"]],
      "strong": [[0, 1], [0.017, 0, "step"], [0.28, 0], [0.35, 1, "hit"]]
    },
    "dot.opacity": {
      "light":  [[0, 1], [0.017, 0, "step"], [0.38, 0], [0.4, 1, "step"]],
      "strong": [[0, 1], [0.017, 0, "step"], [0.35, 0], [0.367, 1, "step"]]
    },
    "dot.scale": {
      "light":  [[0, 1], [0.017, 0.4, "step"], [0.38, 0.4], [0.44, 1.3, "out"], [0.5, 0.95], [0.55, 1]],
      "strong": [[0, 1], [0.017, 0.4, "step"], [0.35, 0.4], [0.41, 1.5, "out"], [0.48, 0.9], [0.54, 1.05], [0.59, 1]]
    },
    "clock.x": {
      "strong": [[0, 0], [0.3, 0], [0.34, -1.1, "out"], [0.4, 0.9, "inOut"], [0.46, -0.5, "inOut"], [0.52, 0.25, "inOut"], [0.57, 0, "inOut"]]
    }
  }
}
