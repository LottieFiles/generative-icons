{
  "$schema": "https://gen-animated-icons.lottiefiles.com/schema/icon-v2.json",
  "format": "gai-icon/2",
  "id": "booking-confirmed",
  "label": "Booking confirmed",
  "intent": "A check is written onto the calendar to confirm the booking. Light: the short stroke of the check draws down to the corner, the long stroke draws up a beat later, and the check pops once as the booking is set. Strong: both strokes snap on with hard stops at the corner and the tip, the check pops harder, and the calendar takes it with a thump, a rebound and a settle. The leaf stays rigid.",
  "parts": {
    "leaf":    {"shape": {"rect": [5, 6, 22, 21], "r": 2.7}, "role": "surface", "solid": "ring"},
    "header":  {"shape": {"line": [[5.5, 11.5], [26.5, 11.5]]}},
    "peg-l":   {"shape": {"line": [[11, 4], [11, 8]]}},
    "peg-r":   {"shape": {"line": [[21, 4], [21, 8]]}},
    "check-a": {"shape": {"line": [[11.7, 19.5], [14.7, 22.5]]}},
    "check-b": {"shape": {"line": [[14.7, 22.5], [20.5, 15.9]]}}
  },
  "rigs": {
    "calendar": {"//": "the whole calendar takes the confirmation in Strong", "pivot": [16, 27], "carries": ["leaf", "header", "peg-l", "peg-r", "check"]},
    "check":    {"//": "the check pops about its own centre once it is written", "pivot": [16.1, 19.2], "carries": ["check-a", "check-b"]}
  },
  "motion": {
    "check-a.draw": {
      "light":  [[0, 1], [0.017, 0, "step"], [0.04, 0], [0.15, 1, "in"]],
      "strong": [[0, 1], [0.017, 0, "step"], [0.04, 0], [0.12, 1, "hit"]]
    },
    "check-b.draw": {
      "light":  [[0, 1], [0.017, 0, "step"], [0.15, 0], [0.31, 1, "out"]],
      "strong": [[0, 1], [0.017, 0, "step"], [0.14, 0], [0.25, 1, "hit"]]
    },
    "check.scale": {
      "light":  [[0, 1], [0.31, 1], [0.37, 1.2, "out"], [0.44, 0.96], [0.5, 1]],
      "strong": [[0, 1], [0.25, 1], [0.31, 1.3, "out"], [0.39, 0.92], [0.46, 1.04], [0.52, 1]]
    },
    "calendar.y": {
      "strong": [[0, 0], [0.31, 0], [0.36, 1.2, "hit"], [0.44, -0.3], [0.51, 0.1], [0.57, 0]]
    }
  }
}
