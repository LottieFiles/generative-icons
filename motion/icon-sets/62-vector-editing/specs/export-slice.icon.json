{
  "$schema": "https://gen-animated-icons.lottiefiles.com/schema/icon-v2.json",
  "format": "gai-icon/2",
  "id": "export-slice",
  "label": "Export slice",
  "intent": "A copy of the selected slice is exported. Light: the tile presses down and a copy of it springs up out of the open region, shrinking as it goes, and disappears into the export arrow, which kicks up as it arrives and settles. Strong: two copies leave in turn (two export sizes), the tile presses for each and the arrow kicks twice, harder the second time. The region marks never move.",
  "parts": {
    "region-0": {"shape": {"line": [[5, 12], [5, 17]]}},
    "region-1": {"shape": {"polyline": [[5, 22], [5, 27], [10, 27]]}},
    "region-2": {"shape": {"line": [[15, 27], [20, 27]]}},
    "region-3": {"shape": {"polyline": [[25, 27], [27, 27], [27, 22]]}},
    "region-4": {"shape": {"line": [[27, 17], [27, 12]]}},
    "slice": {"shape": {"rect": [10, 16, 12, 7], "r": 1.5}, "role": "surface", "solid": "fill"},
    "copy": {
      "//": "hidden at rest: the exported copy leaves from the tile and fades into the arrow",
      "shape": {"rect": [10, 16, 12, 7], "r": 1.5},
      "role": "surface",
      "solid": "fill",
      "hidden": true
    },
    "arrow": {"shape": {"line": [[16, 8.4], [16, 4.5]]}},
    "arrow-head": {"shape": {"polyline": [[12.5, 8], [16, 4.5], [19.5, 8]]}}
  },
  "rigs": {
    "copy": {
      "pivot": [16, 19.5]
    },
    "export": {
      "pivot": [16, 6.25],
      "carries": ["arrow", "arrow-head"]
    }
  },
  "motion": {
    "slice.y": {
      "light": [[0, 0], [0.05, 0.7, "out"], [0.14, 0]],
      "strong": [[0, 0], [0.05, 0.7, "out"], [0.13, 0], [0.25, 0], [0.3, 0.9, "out"], [0.39, 0]]
    },
    "copy.opacity": {
      "light": [[0, 0], [0.04, 1, "out"], [0.13, 1], [0.21, 0, "in"]],
      "strong": [[0, 0], [0.04, 1, "out"], [0.12, 1], [0.19, 0, "in"], [0.25, 0], [0.29, 1, "out"], [0.37, 1], [0.44, 0, "in"]]
    },
    "copy.y": {
      "light": [[0, 0], [0.21, -9, "out"], [0.23, 0, "step"]],
      "strong": [[0, 0], [0.19, -9, "out"], [0.21, 0, "step"], [0.25, 0], [0.44, -9, "out"], [0.46, 0, "step"]]
    },
    "copy.scale": {
      "light": [[0, 1], [0.21, 0.4, "out"], [0.23, 1, "step"]],
      "strong": [[0, 1], [0.19, 0.4, "out"], [0.21, 1, "step"], [0.25, 1], [0.44, 0.4, "out"], [0.46, 1, "step"]]
    },
    "export.y": {
      "light": [[0, 0], [0.12, 0], [0.2, -1.5, "out"], [0.29, 0.3], [0.38, 0]],
      "strong": [[0, 0], [0.11, 0], [0.18, -1.2, "out"], [0.26, 0.2], [0.32, 0], [0.36, 0], [0.43, -1.6, "out"], [0.52, 0.35], [0.6, -0.1], [0.68, 0]]
    }
  }
}
