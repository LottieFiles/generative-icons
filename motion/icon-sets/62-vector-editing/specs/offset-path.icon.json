{
  "$schema": "https://gen-animated-icons.lottiefiles.com/schema/icon-v2.json",
  "format": "gai-icon/2",
  "id": "offset-path",
  "label": "Offset path",
  "intent": "The source pushes its offset out. Light: a copy of the source's outline ripples outward and fades as it reaches the offset contour, which is pushed out by the wave, rebounds and settles. Strong: two ripples leave the source in turn and the offset takes two decaying pushes. The source never moves.",
  "parts": {
    "offset": {"shape": {"rect": [6.5, 6.5, 19, 19], "r": 3.3}},
    "ripple": {
      "//": "hidden at rest: the outline travelling from the source to the offset (the offsetting itself)",
      "shape": {"morph": [{"rect": [12, 12, 8, 8], "r": 1.6}, {"rect": [6.5, 6.5, 19, 19], "r": 3.3}], "by": "spread"},
      "hidden": true
    },
    "source": {"shape": {"rect": [12, 12, 8, 8], "r": 1.6}, "role": "surface", "solid": "fill"}
  },
  "motion": {
    "spread": {
      "light": [[0, 0], [0.22, 0.92, "linear"], [0.24, 0, "step"]],
      "strong": [[0, 0], [0.19, 0.92, "linear"], [0.21, 0, "step"], [0.25, 0], [0.44, 0.92, "linear"], [0.46, 0, "step"]]
    },
    "ripple.opacity": {
      "light": [[0, 0], [0.04, 1, "out"], [0.14, 1], [0.22, 0, "in"]],
      "strong": [[0, 0], [0.04, 1, "out"], [0.12, 1], [0.19, 0, "in"], [0.25, 0], [0.29, 1, "out"], [0.37, 1], [0.44, 0, "in"]]
    },
    "offset.grow": {
      "light": [[0, 0], [0.16, 0], [0.23, 1.3, "hit"], [0.32, -0.3], [0.42, 0]],
      "strong": [[0, 0], [0.13, 0], [0.2, 1.2, "hit"], [0.28, -0.3], [0.36, 0.15], [0.38, 0.15], [0.45, 1.8, "hit"], [0.54, -0.45], [0.63, 0.15], [0.73, 0]]
    }
  }
}
