{
  "$schema": "https://gen-animated-icons.lottiefiles.com/schema/icon-v2.json",
  "format": "gai-icon/2",
  "id": "external-link",
  "label": "External link",
  "intent": "The link leaves. Light: the arrow winds back a touch, shoots out through the open corner and fades before the edge, then a new arrow glides in from inside the window and settles at rest. Strong: it leaves farther with a speed trail that retracts into the corner behind it, and the returning arrow overshoots toward the corner and rebounds. The window never moves.",
  "parts": {
    "frame": {"shape": {"polyline": [[13, 7], [7, 7], [7, 25], [25, 25], [25, 19]], "r": 2}},
    "trail": {"//": "hidden at rest: the shaft's wake, drawn from the corner inward and retracted into the corner as the arrow leaves", "shape": {"line": [[25, 7], [15.5, 16.5]]}, "hidden": true},
    "shaft": {"shape": {"line": [[15.5, 16.5], [25, 7]]}},
    "head":  {"shape": {"polyline": [[18.5, 7], [25, 7], [25, 13.5]]}}
  },
  "rigs": {
    "arrow": {"pivot": [25, 7], "carries": ["shaft", "head"]}
  },
  "motion": {
    "arrow.x": {
      "light":  [[0, 0], [0.05, -0.5, "out"], [0.17, 3.4, "linear"], [0.19, -3.5, "step"], [0.38, 0.4, "out"], [0.46, 0]],
      "strong": [[0, 0], [0.05, -0.8, "out"], [0.17, 4.3, "linear"], [0.19, -4.5, "step"], [0.36, 1.2, "out"], [0.46, -0.3], [0.56, 0]]
    },
    "arrow.y": {"follow": "arrow.x", "scale": -1},
    "shaft.opacity": {
      "light":  [[0, 1], [0.10, 1], [0.17, 0, "in"], [0.19, 0], [0.30, 1, "out"]],
      "strong": [[0, 1], [0.11, 1], [0.17, 0, "in"], [0.19, 0], [0.30, 1, "out"]]
    },
    "head.opacity": {"follow": "shaft.opacity"},
    "trail.opacity": {
      "strong": [[0, 0], [0.069, 0], [0.07, 1, "step"], [0.12, 1], [0.19, 0, "in"]]
    },
    "trail.draw": {
      "strong": [[0, 1], [0.07, 1], [0.19, 0, "in"], [0.21, 1, "step"]]
    }
  }
}
