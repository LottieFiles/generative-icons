    "sweep": {
      "//": "hidden at rest: the rest of v1's end marquee, from the bracket's end round to its start; bracket + sweep is v1's closed boundary",
      "shape": {
        "path": "M16 4.5 L25.5 4.5 C26.605 4.5 27.5 5.395 27.5 6.5 L27.5 25.5 C27.5 26.605 26.605 27.5 25.5 27.5 L6.5 27.5 C5.395 27.5 4.5 26.605 4.5 25.5 L4.5 16"
      },
      "hidden": true
    },
    "tile-0": {"shape": {"rect": [8.5, 8.5, 4, 4], "r": 1.2}, "role": "surface"},
    "tile-1": {"shape": {"rect": [19.5, 8.5, 4, 4], "r": 1.2}, "role": "surface"},
    "tile-2": {"shape": {"rect": [8.5, 19.5, 4, 4], "r": 1.2}, "role": "surface"},
    "tile-3": {"shape": {"rect": [19.5, 19.5, 4, 4], "r": 1.2}, "role": "surface"}
  },
  "rigs": {
