{
  "$schema": "https://gen-animated-icons.lottiefiles.com/schema/icon-v2.json",
  "format": "gai-icon/2",
  "id": "cut",
  "label": "Cut",
  "intent": "The scissors snip and the cut runs ahead of them. Light: the blades open and snap shut, a cut line draws out up between them as they close and fades, then a smaller second snip. Strong: three decaying snips, wider, and the cut extends further with each of the first two.",
  "parts": {
    "cut-line": {"//": "hidden at rest: the slit only exists while the blades close", "shape": {"line": [[16, 7.5], [16, 2.8]]}, "hidden": true},
    "blade-b": {"shape": [{"circle": [[21.5, 25], 2.7]}, {"line": [[20.199, 22.634], [10.775, 5.5]]}]},
    "blade-a": {"shape": [{"circle": [[10.5, 25], 2.7]}, {"line": [[11.801, 22.634], [21.225, 5.5]]}]}
  },
  "rigs": {
    "blade-a": {"pivot": [16, 15]},
    "blade-b": {"pivot": [16, 15]}
  },
  "motion": {
    "blade-a.rotate": {
      "light":  [[0, 0], [0.09, 18, "out"], [0.16, -5, "hit"], [0.25, 9, "out"], [0.31, -2, "hit"], [0.40, 0]],
      "strong": [[0, 0], [0.11, 28, "out"], [0.19, -6, "hit"], [0.29, 16, "out"], [0.36, -4, "hit"], [0.45, 7, "out"], [0.51, -1.5, "hit"], [0.60, 0]]
    },
    "blade-b.rotate": {"follow": "blade-a.rotate", "scale": -1},
    "cut-line.draw": {
      "light":  [[0, 1], [0.017, 0, "step"], [0.10, 0], [0.17, 1, "out"]],
      "strong": [[0, 1], [0.017, 0, "step"], [0.12, 0], [0.19, 0.55, "out"], [0.30, 0.55], [0.37, 1, "out"]]
    },
    "cut-line.opacity": {
      "light":  [[0, 0], [0.10, 0], [0.12, 1, "out"], [0.22, 1], [0.34, 0, "in"]],
      "strong": [[0, 0], [0.12, 0], [0.14, 1, "out"], [0.42, 1], [0.56, 0, "in"]]
    }
  }
}
