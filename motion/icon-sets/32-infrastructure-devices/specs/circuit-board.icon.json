      "light":  [[0, 1], [0.02, 0, "step"], [0.18, 1, "in"]],
      "strong": [[0, 1], [0.02, 0, "step"], [0.17, 1, "in"], [0.32, 0, "step"], [0.44, 1, "in"]]
    },
    "trace-2.draw": {"follow": "trace-1.draw", "lag": 0.07},
    "trace-3.draw": {"follow": "trace-1.draw", "lag": 0.14},
    "pad-1.scale": {
      "light":  [[0, 1], [0.17, 1], [0.21, 1.4, "out"], [0.29, 0.92], [0.35, 1]],
      "strong": [[0, 1], [0.16, 1], [0.2, 1.3, "out"], [0.27, 0.95], [0.31, 1], [0.43, 1], [0.47, 1.5, "out"], [0.55, 0.9], [0.61, 1.04], [0.67, 1]]
    },
    "pad-2.scale": {"follow": "pad-1.scale", "lag": 0.07},
    "pad-3.scale": {"follow": "pad-1.scale", "lag": 0.14}
  }
