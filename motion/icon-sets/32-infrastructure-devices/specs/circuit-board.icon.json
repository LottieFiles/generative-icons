    "trace-2": {"shape": {"line": [[5, 16], [15, 16]]}},
    "trace-3": {"shape": {"polyline": [[21.5, 27], [21.5, 22], [12, 22]], "r": 2}},
    "pad-1":   {"shape": {"circle": [[21, 10], 2]}, "role": "fill"},
    "pad-2":   {"shape": {"circle": [[16, 16], 2]}, "role": "fill"},
    "pad-3":   {"shape": {"circle": [[11, 22], 2]}, "role": "fill"},
    "board":   {"//": "Solid is a ring so the traces can draw and the pads flash on it", "shape": {"rect": [4, 4, 24, 24], "r": 3}, "role": "surface", "solid": "ring"}
  },
  "motion": {
