{
  "$schema": "https://gen-animated-icons.lottiefiles.com/schema/icon-v2.json",
  "format": "gai-icon/2",
  "id": "firewall",
  "label": "Firewall",
  "intent": "Traffic is blocked. Light: the arrow drives into the wall and stops dead; an impact burst flicks off the wall's face above and below it, and the arrow is knocked back, overshoots and settles. Strong: the arrow winds back first and strikes harder, the bigger burst flies further, and the wall shudders once and holds.",
  "parts": {
    "arrow-head":    {"shape": {"polyline": [[6.5, 13.5], [9, 16], [6.5, 18.5]]}},
    "arrow-shaft":   {"shape": {"line": [[4, 16], [9, 16]]}},
    "mortar-bottom": {"//": "Solid: v1 draws the wall as four tiles split by the mortar; each wall part carries one tile",
                      "shape": {"line": [[19.5, 16], [19.5, 27]]}, "solid": {"rect": [13.7, 17.3, 4.5, 11], "r": 1.5}},
    "mortar-top":    {"shape": {"line": [[21.5, 5], [21.5, 16]]}, "solid": {"rect": [22.8, 3.7, 6.5, 11], "r": 1.5}},
    "mortar-h":      {"shape": {"line": [[15, 16], [28, 16]]}, "solid": {"rect": [13.7, 3.7, 6.5, 11], "r": 1.5}},
    "wall":          {"shape": {"rect": [15, 5, 13, 22], "r": 2}, "role": "surface", "solid": {"rect": [20.8, 17.3, 8.5, 11], "r": 1.5}},
    "burst-u":       {"//": "hidden at rest: the impact only exists as the arrow strikes", "shape": {"line": [[12.4, 11.4], [11.2, 9.6]]}, "hidden": true},
    "burst-d":       {"mirror": {"of": "burst-u", "y": 16}}
  },
  "rigs": {
    "arrow": {"pivot": [6.5, 16], "carries": ["arrow-head", "arrow-shaft"]},
    "brick": {"pivot": [21.5, 16], "carries": ["wall", "mortar-h", "mortar-top", "mortar-bottom"]}
  },
  "motion": {
    "arrow.x": {
      "light":  [[0, 0], [0.16, 3.6, "hit"], [0.27, -0.5], [0.37, 0]],
      "strong": [[0, 0], [0.12, -1.2, "out"], [0.26, 3.6, "hit"], [0.36, -1], [0.46, 0.4], [0.55, 0]]
    },
    "brick.x": {
      "strong": [[0, 0], [0.26, 0], [0.29, 0.6, "out"], [0.36, -0.25], [0.44, 0]]
    },
    "burst-u.opacity": {
      "light":  [[0, 0], [0.15, 0], [0.17, 1, "out"], [0.26, 1], [0.35, 0, "in"]],
      "strong": [[0, 0], [0.25, 0], [0.27, 1, "out"], [0.37, 1], [0.47, 0, "in"]]
    },
    "burst-u.x": {
      "light":  [[0, 0], [0.16, 0], [0.35, -1, "out"], [0.37, 0, "step"]],
      "strong": [[0, 0], [0.26, 0], [0.47, -1.6, "out"], [0.49, 0, "step"]]
    },
    "burst-u.y": {
      "light":  [[0, 0], [0.16, 0], [0.35, -1, "out"], [0.37, 0, "step"]],
      "strong": [[0, 0], [0.26, 0], [0.47, -1.6, "out"], [0.49, 0, "step"]]
    },
    "burst-d.opacity": {"follow": "burst-u.opacity"},
    "burst-d.x": {"follow": "burst-u.x"},
    "burst-d.y": {"follow": "burst-u.y", "scale": -1}
  }
}
