{
  "$schema": "https://gen-animated-icons.lottiefiles.com/schema/icon-v2.json",
  "format": "gai-icon/2",
  "id": "server",
  "label": "Server",
  "intent": "The server handles a request: its activity lights flash in turn. Light: the top unit's light flares and settles, and the bottom unit's light answers a beat later. Strong: both lights flash twice, top then bottom, the second flash bigger. The lights never go out (in Solid they are windows that must stay open), and the rack units never move.",
  "parts": {
    "unit-top-led":    {"shape": {"circle": [[20.5, 10], 1.3]}, "role": "fill"},
    "unit-top-bar":    {"shape": {"line": [[8, 10], [12, 10]]}},
    "unit-top":        {"shape": {"rect": [4, 6, 21, 8], "r": 2.5}, "role": "surface",
                        "knockout": [{"part": "unit-top-bar", "gap": 0}, {"part": "unit-top-led", "gap": 0}]},
    "unit-bottom-led": {"shape": {"circle": [[20.5, 22], 1.3]}, "role": "fill"},
    "unit-bottom-bar": {"shape": {"line": [[8, 22], [12, 22]]}},
    "unit-bottom":     {"shape": {"rect": [4, 18, 21, 8], "r": 2.5}, "role": "surface",
                        "knockout": [{"part": "unit-bottom-bar", "gap": 0}, {"part": "unit-bottom-led", "gap": 0}]}
  },
  "motion": {
    "unit-top-led.scale": {
      "light":  [[0, 1], [0.1, 1.75, "out"], [0.2, 0.9], [0.3, 1]],
      "strong": [[0, 1], [0.08, 1.6, "out"], [0.17, 0.92], [0.25, 1], [0.33, 1.85, "out"], [0.43, 0.88], [0.53, 1]]
    },
    "unit-bottom-led.scale": {"follow": "unit-top-led.scale", "lag": 0.12}
  }
}
