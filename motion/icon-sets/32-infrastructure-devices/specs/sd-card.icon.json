{
  "$schema": "https://gen-animated-icons.lottiefiles.com/schema/icon-v2.json",
  "format": "gai-icon/2",
  "id": "sd-card",
  "label": "SD card",
  "intent": "Data is written to the SD card. Light: a data packet drops onto the top of the card and fades as it lands; the contacts take it, dip, rebound and settle. Strong: two packets land in turn and the contacts take two hits, the second deeper. The card never moves.",
  "parts": {
    "contacts": {"shape": [
                   {"line": [[11, 11.5], [11, 14.5]]},
                   {"line": [[15, 11.5], [15, 14.5]]},
                   {"line": [[19, 11.5], [19, 14.5]]}
                 ]},
    "card":     {"shape": {"polygon": [[8.5, 6.5], {"p": [19.5, 6.5], "r": 1}, {"p": [23.5, 10.5], "r": 1}, [23.5, 26.5], [8.5, 26.5]], "r": 2},
                 "role": "surface", "knockout": [{"part": "contacts", "gap": 0}]},
    "packet":   {"//": "hidden at rest: the data only exists while it drops in", "shape": {"circle": [[15, 2.9], 1.5]}, "role": "fill", "hidden": true}
  },
  "motion": {
    "packet.opacity": {
      "light":  [[0, 0], [0.05, 1, "out"], [0.14, 1], [0.19, 0, "in"]],
      "strong": [[0, 0], [0.04, 1, "out"], [0.11, 1], [0.16, 0, "in"], [0.22, 0], [0.26, 1, "out"], [0.33, 1], [0.38, 0, "in"]]
    },
    "packet.y": {
      "light":  [[0, 0], [0.19, 4, "in"], [0.21, 0, "step"]],
      "strong": [[0, 0], [0.16, 4, "in"], [0.18, 0, "step"], [0.22, 0], [0.38, 4, "in"], [0.4, 0, "step"]]
    },
    "contacts.y": {
      "light":  [[0, 0], [0.17, 0], [0.22, 1.4, "hit"], [0.31, -0.3], [0.4, 0]],
      "strong": [[0, 0], [0.14, 0], [0.19, 1.1, "hit"], [0.26, -0.2], [0.33, 0.1], [0.4, 2, "hit"], [0.49, -0.4], [0.58, 0.15], [0.66, 0]]
    }
  }
}
