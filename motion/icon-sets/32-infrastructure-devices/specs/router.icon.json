{
  "$schema": "https://gen-animated-icons.lottiefiles.com/schema/icon-v2.json",
  "format": "gai-icon/2",
  "id": "router",
  "label": "Router",
  "intent": "The router broadcasts. Light: the status light blinks, then a signal arc leaves the tip of each antenna, travels outward and fades. Strong: two blinks and two waves in turn, the second wave travelling further. The box and the antennas never move.",
  "parts": {
    "antenna-r": {"shape": {"line": [[22, 18], [22, 8]]}},
    "antenna-l": {"shape": {"line": [[10, 18], [10, 8]]}},
    "status":    {"shape": {"circle": [[16, 21.5], 1.1]}, "role": "fill"},
    "body":      {"shape": {"rect": [5, 18, 22, 7], "r": 2}, "role": "surface", "knockout": [{"part": "status", "gap": 0.2}]},
    "wave-l":    {"//": "hidden at rest: the signal only exists while it travels", "shape": {"arc": [[10, 8], 3, -140, -40]}, "hidden": true},
    "wave-r":    {"mirror": {"of": "wave-l"}}
  },
  "motion": {
    "status.scale": {
      "light":  [[0, 1], [0.08, 1.7, "out"], [0.19, 0.9], [0.28, 1]],
      "strong": [[0, 1], [0.07, 1.6, "out"], [0.16, 0.92], [0.24, 1], [0.32, 1.8, "out"], [0.42, 0.9], [0.5, 1]]
    },
    "wave-l.opacity": {
      "light":  [[0, 0], [0.07, 0], [0.11, 1, "out"], [0.24, 1], [0.36, 0, "in"]],
      "strong": [[0, 0], [0.06, 0], [0.1, 1, "out"], [0.2, 1], [0.3, 0, "in"], [0.31, 0], [0.35, 1, "out"], [0.48, 1], [0.6, 0, "in"]]
    },
    "wave-l.r": {
      "light":  [[0, 0], [0.07, 0], [0.36, 1.6, "out"], [0.38, 0, "step"]],
      "strong": [[0, 0], [0.06, 0], [0.3, 1.3, "out"], [0.31, 0, "step"], [0.6, 1.8, "out"], [0.62, 0, "step"]]
    },
    "wave-r.opacity": {"follow": "wave-l.opacity"},
    "wave-r.r": {"follow": "wave-l.r"}
  }
}
