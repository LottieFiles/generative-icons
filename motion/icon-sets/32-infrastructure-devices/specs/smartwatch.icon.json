{
  "$schema": "https://gen-animated-icons.lottiefiles.com/schema/icon-v2.json",
  "format": "gai-icon/2",
  "id": "smartwatch",
  "label": "Smartwatch",
  "intent": "The smartwatch buzzes with a notification. Light: the rigid watch rattles side to side in a quick decaying buzz, and a ripple of vibration leaves each side and fades as it spreads. Strong: two bursts, buzz, pause, buzz, with a twist in the rattle and a ripple on each burst. The watch never bends.",
  "parts": {
    "ripple-r":     {"//": "hidden at rest: the vibration only exists while the watch buzzes", "shape": {"arc": [[16, 16], 11.5, -25, 25]}, "hidden": true},
    "ripple-l":     {"mirror": {"of": "ripple-r"}},
    "strap-top":    {"shape": {"polygon": [[12, 9], {"p": [12.8, 4.6], "r": 1}, {"p": [19.2, 4.6], "r": 1}, [20, 9]]}, "role": "surface", "outline": "open"},
    "strap-bottom": {"mirror": {"of": "strap-top", "y": 16}},
    "crown":        {"shape": {"line": [[22.5, 14], [24.6, 14]]}},
    "hands":        {"shape": {"polyline": [[16, 12.4], [16, 16], [18.6, 17.5]], "r": 0.6}},
    "body":         {"shape": {"rect": [9.5, 9, 13, 14], "r": 3.5}, "role": "surface", "knockout": [{"part": "hands", "gap": 0.2}]}
  },
  "rigs": {
    "watch": {"pivot": [16, 16], "carries": ["body", "hands", "crown", "strap-top", "strap-bottom"]}
  },
  "motion": {
    "watch.x": {
      "light":  [[0, 0], [0.03, -1.1], [0.07, 1.1], [0.11, -0.9], [0.15, 0.65], [0.19, -0.4], [0.23, 0.15], [0.27, 0]],
      "strong": [[0, 0], [0.03, -1.2], [0.07, 1.2], [0.11, -1], [0.15, 0.75], [0.19, -0.4], [0.23, 0],
                 [0.33, 0], [0.36, -1.4], [0.4, 1.4], [0.44, -1.2], [0.48, 1], [0.52, -0.7], [0.56, 0.35], [0.6, -0.12], [0.64, 0]]
    },
    "watch.rotate": {
      "//": "Strong only: the rattle twists a little with the buzz",
      "strong": {"follow": "watch.x", "scale": 3}
    },
    "ripple-r.opacity": {
      "light":  [[0, 0], [0.04, 0], [0.08, 1, "out"], [0.2, 0.7], [0.36, 0, "in"]],
      "strong": [[0, 0], [0.04, 0], [0.07, 1, "out"], [0.16, 0.7], [0.29, 0, "in"], [0.36, 0], [0.39, 1, "out"], [0.5, 0.7], [0.66, 0, "in"]]
    },
    "ripple-r.r": {
      "light":  [[0, 0], [0.04, 0.2], [0.36, 1.4, "out"], [0.38, 0, "step"]],
      "strong": [[0, 0], [0.04, 0.2], [0.29, 1.3, "out"], [0.31, 0, "step"], [0.36, 0.2], [0.66, 1.6, "out"], [0.68, 0, "step"]]
    },
    "ripple-l.opacity": {"follow": "ripple-r.opacity"},
    "ripple-l.r": {"follow": "ripple-r.r"}
  }
}
