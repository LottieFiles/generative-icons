{
  "$schema": "https://gen-animated-icons.lottiefiles.com/schema/icon-v2.json",
  "format": "gai-icon/2",
  "id": "tablet",
  "label": "Tablet",
  "intent": "A tap wakes the tablet. Light: a fingertip taps the screen and a touch ripple spreads from it and fades, then a glint draws across the glass as the screen comes on and fades. Strong: a double tap, two ripples, the second wider, then a longer glint. The tablet never moves.",
  "parts": {
    "home":   {"shape": {"line": [[13.5, 24.5], [18.5, 24.5]]}},
    "glint":  {"//": "hidden at rest: the screen coming on", "shape": [{"line": [[15.5, 13], [20, 8.5]]}, {"line": [[18.5, 15.5], [20.5, 13.5]]}], "hidden": true},
    "body":   {"shape": {"rect": [7, 4, 18, 24], "r": 3}, "role": "surface",
               "knockout": [{"part": "home", "gap": 0.3}, {"part": "glint", "gap": 0.3}]},
    "ripple": {"//": "hidden at rest: the touch only exists while it spreads; not drawn in Solid", "shape": {"circle": [[14.5, 16], 1.2]}, "hidden": true, "solid": "none"}
  },
  "motion": {
    "ripple.opacity": {
      "light":  [[0, 0], [0.03, 1, "out"], [0.1, 0.9], [0.24, 0, "in"]],
      "strong": [[0, 0], [0.03, 1, "out"], [0.08, 0.9], [0.18, 0, "in"], [0.2, 0], [0.23, 1, "out"], [0.28, 0.9], [0.4, 0, "in"]]
    },
    "ripple.r": {
      "light":  [[0, 0], [0.24, 2.7, "out"], [0.26, 0, "step"]],
      "strong": [[0, 0], [0.18, 2, "out"], [0.2, 0, "step"], [0.4, 3.1, "out"], [0.42, 0, "step"]]
    },
    "glint.opacity": {
      "light":  [[0, 0], [0.16, 0], [0.18, 1], [0.36, 1], [0.46, 0]],
      "strong": [[0, 0], [0.34, 0], [0.36, 1], [0.62, 1], [0.74, 0]]
    },
    "glint.draw": {
      "light":  [[0, 1], [0.16, 0, "step"], [0.32, 1, "out"]],
      "strong": [[0, 1], [0.34, 0, "step"], [0.54, 1, "out"]]
    }
  }
}
