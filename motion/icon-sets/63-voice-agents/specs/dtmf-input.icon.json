{
  "$schema": "https://gen-animated-icons.lottiefiles.com/schema/icon-v2.json",
  "format": "gai-icon/2",
  "id": "dtmf-input",
  "label": "DTMF input",
  "intent": "A keypad key is pressed and sounds its dual tone. Light: the key is pushed in (it shrinks into the panel with a hit) and springs back; a beat later both tone waves ring at once, their amplitude swelling and decaying, the low tone in one slow swing and the high tone in quicker flutters. Strong: the key lifts a touch before a harder press, and both tones ring louder and longer. The waves never leave their lines.",
  "parts": {
    "key":       {"shape": {"rect": [5, 8, 11, 15], "r": 2.4}, "role": "surface", "solid": "ring"},
    "digit-one": {"shape": {"polyline": [[8.5, 13.2], [10.7, 11.5], [10.7, 19.5]]}},
    "low-tone":  {"shape": {"path": "M20 11.5 C21.28 10.7 22.72 10.7 24 11.5 C25.28 12.3 26.72 12.3 28 11.5"}},
    "high-tone": {"shape": {"path": "M20 21.2 C20.64 20.4 21.36 20.4 22 21.2 C22.64 22 23.36 22 24 21.2 C24.64 20.4 25.36 20.4 26 21.2 C26.64 22 27.36 22 28 21.2"}}
  },
  "rigs": {
    "press": {"//": "the key and its digit are pushed into the panel", "pivot": [10.5, 15.5], "carries": ["key", "digit-one"]},
    "low":   {"//": "amplitude about the tone's own line; widen 0 keeps its length", "pivot": [24, 11.5], "carries": ["low-tone"], "squash": {"base": 11.5, "widen": 0}},
    "high":  {"pivot": [24, 21.2], "carries": ["high-tone"], "squash": {"base": 21.2, "widen": 0}}
  },
  "motion": {
    "press.scale": {
      "light":  [[0, 1], [0.09, 0.86, "hit"], [0.18, 1.03], [0.26, 1]],
      "strong": [[0, 1], [0.06, 1.05, "out"], [0.14, 0.82, "hit"], [0.24, 1.04], [0.32, 1]]
    },
    "low.squash": {
      "light":  [[0, 1], [0.12, 1], [0.22, 2.3, "out"], [0.33, 0.6], [0.42, 1.2], [0.5, 1]],
      "strong": [[0, 1], [0.17, 1], [0.28, 2.8, "out"], [0.4, 0.4], [0.5, 1.7], [0.6, 0.8], [0.68, 1.1], [0.74, 1]]
    },
    "high.squash": {
      "light":  [[0, 1], [0.12, 1], [0.19, 2.3, "out"], [0.26, 0.5], [0.33, 1.6], [0.4, 0.8], [0.46, 1.1], [0.5, 1]],
      "strong": [[0, 1], [0.17, 1], [0.24, 2.8, "out"], [0.31, 0.3], [0.38, 2.1], [0.45, 0.6], [0.52, 1.5], [0.59, 0.8], [0.66, 1.15], [0.74, 1]]
    }
