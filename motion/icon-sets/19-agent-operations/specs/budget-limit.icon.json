{
  "$schema": "https://gen-animated-icons.lottiefiles.com/schema/icon-v2.json",
  "format": "gai-icon/2",
  "id": "budget-limit",
  "label": "Budget limit",
  "intent": "Usage runs up to the budget limit and is stopped dead there. Light: the usage token gathers speed along the rail and stops hard at the limit with a hit, and a shock flashes out of the far side of the limit wall. Strong: usage advances in two surges, a first spend that pauses, then a run that slams into the limit; the shock is wider, three rays. The token never overshoots or rebounds (no refund) and holds at the limit until the preview reset. The rail never moves.",
  "state": {"from": "prepared", "to": "result", "labels": ["Play action", "Reset preview"], "reverse": "fade"},
  "parts": {
    "rail":     {"shape": {"path": "M4 24 L22.5 24 C23.33 24 24 23.33 24 22.5 L24 13.5 C24 12.67 23.33 12 22.5 12 L20 12"}},
    "token":    {"shape": {"circle": [[8, 21], 2.2]}, "role": "fill"},
    "shock-t":  {"//": "hidden at rest: the shock out of the far side of the limit wall, inner end first; kept 1.4 inside the canvas at Bold", "shape": {"line": [[26.3, 14.8], [27.5, 13.1]]}, "hidden": true},
    "shock-b":  {"mirror": {"of": "shock-t", "y": 18}},
    "shock-m":  {"//": "Strong only: the middle ray", "shape": {"line": [[26.7, 18], [28.5, 18]]}, "hidden": true}
  },
  "motion": {
    "//": "v1's end state is the token 11.4 along, just short of the wall. A hit, never an overshoot: usage does not cross the limit or come back.",
    "token.x": {
      "light":  [[0, 0], [0.34, 11.4, "hit"]],
      "strong": [[0, 0], [0.17, 5.4, "out"], [0.25, 5.4], [0.42, 11.4, "hit"]]
    },
    "shock-t.opacity": {
      "light":  [[0, 0], [0.34, 0], [0.36, 1, "out"], [0.44, 1], [0.52, 0, "in"]],
      "strong": [[0, 0], [0.42, 0], [0.44, 1, "out"], [0.53, 1], [0.62, 0, "in"]]
    },
    "shock-t.draw": {
      "light":  [[0, 1], [0.34, 0, "step"], [0.41, 1, "out"]],
      "strong": [[0, 1], [0.42, 0, "step"], [0.49, 1, "out"]]
    },
    "shock-t.x": {
      "light":  [[0, 0], [0.34, 0], [0.52, 0.3, "out"], [0.54, 0, "step"]],
      "strong": [[0, 0], [0.42, 0], [0.62, 0.4, "out"], [0.64, 0, "step"]]
    },
    "shock-b.opacity": {"follow": "shock-t.opacity"},
    "shock-b.draw": {"follow": "shock-t.draw"},
    "shock-b.x": {"follow": "shock-t.x"},
    "shock-m.opacity": {
      "strong": [[0, 0], [0.42, 0], [0.44, 1, "out"], [0.53, 1], [0.62, 0, "in"]]
