    },
    "trail-top.scale": {
      "light":  [[0, 1], [0.04, 1], [0.2, 0.25, "hit"], [0.27, 0.34], [0.33, 0.3142857]],
      "strong": [[0, 1], [0.04, 1], [0.16, 0.62, "hit"], [0.24, 0.62], [0.34, 0.24, "hit"], [0.42, 0.35], [0.5, 0.3142857]]
    },
    "trail-mid.scale":    {"follow": "trail-top.scale", "lag": 0.05},
    "trail-bottom.scale": {"follow": "trail-top.scale", "lag": 0.1}
  }
