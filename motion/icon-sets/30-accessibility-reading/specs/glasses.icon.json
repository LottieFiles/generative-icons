    "temple-l": {"shape": {"path": "M4.62 15.8 L6.9 10.2 C7.5 8.9 8.6 8.2 10.3 8.2"}},
    "temple-r": {"mirror": {"of": "temple-l"}},
    "lens-l":   {"shape": {"circle": [[9.3, 18.5], 5.4]}, "role": "surface", "solid": "ring"},
    "lens-r":   {"mirror": {"of": "lens-l"}},
    "bridge":   {"shape": {"arc": [[16, 18.5], 2.6, -130, -50]}},
    "glint-l":  {"//": "hidden at rest: drawn across the lens from its lower end", "shape": {"arc": [[9.3, 18.5], 2.6, -100, -165]}, "hidden": true},
    "glint-r":  {"shape": {"arc": [[22.7, 18.5], 2.6, -100, -165]}, "hidden": true}
  },
  "rigs": {
    "glasses": {"pivot": [16, 18.5], "carries": ["temple-l", "temple-r", "lens-l", "lens-r", "bridge", "glint-l", "glint-r"]}
  },
  "motion": {
