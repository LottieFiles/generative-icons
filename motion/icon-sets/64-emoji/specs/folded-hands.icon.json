      },
      "role": "surface",
      "knockout": [{"part": "seam", "gap": 0}],
      "solid": "fill"
    },
    "seam": {
      "//": "the palms meet down the middle, fingertips to heels; in Solid it splits the two hands",
      "shape": {"line": [[16, 8.2], [16, 18]]},
      "solid": {"rect": [15.2, 7, 1.6, 11.4], "r": 0.8}
    },
    "cuff-l": {
      "//": "a hint of sleeve at each wrist, angled down and out",
      "shape": {"polygon": [[9.87, 18.98], [14.13, 21.82], [11.97, 25.06], [7.71, 22.22]], "r": 0.8},
      "role": "surface",
      "solid": "fill",
      "gap": {"hands": 1}
    },
    "cuff-r": {"mirror": {"of": "cuff-l"}},
    "ray-c": {
      "//": "hidden at rest: a glow above the fingertips as they bow",
      "shape": {"line": [[16.0, 6.0], [16.0, 4.4]]},
