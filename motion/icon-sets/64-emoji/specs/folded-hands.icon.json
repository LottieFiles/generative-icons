{
  "$schema": "https://gen-animated-icons.lottiefiles.com/schema/icon-v2.json",
  "format": "gai-icon/2",
  "id": "folded-hands",
  "label": "Folded hands",
  "intent": "A thank-you bow: two palms pressed together, fingers up, sleeves at the wrists. Light: the hands press together (a little taller and narrower), then bow toward the viewer, foreshortening down onto the wrists, as three short glow rays appear above the fingertips and fade; they rise back to rest. Strong: a firmer press, a deeper bow, a quick rise and a second, smaller bow, and the rays reach farther.",
