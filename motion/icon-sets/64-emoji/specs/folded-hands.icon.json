      "strong": [[0, 1], [0.1, 1.05, "out"], [0.3, 0.8, "inOut"], [0.38, 0.82], [0.49, 0.97, "inOut"], [0.58, 0.9, "inOut"], [0.72, 1, "inOut"]]
    },
