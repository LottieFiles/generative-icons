  "format": "gai-icon/2",
  "id": "max-tokens",
  "label": "Max tokens",
  "intent": "Set a hard output length. Light: the end bracket slams 5 units in toward the output and stops dead at the new limit with a small rebound; the output rows flinch back from it in turn (longest row first) and settle. Strong: the bracket is pulled back first, slams in, rebounds and hits again; the rows flinch harder and twice. The bracket never passes the new limit (no overshoot on the value) and stays there. The reverse: the bracket is pressed in to release, then swings back out to the large limit and lands; the rows breathe out after it.",
  "state": {
    "from": "large-maximum",
    "to": "small-maximum",
    "labels": ["Limit", "Expand"],
    "reverse": "auto"
  },
