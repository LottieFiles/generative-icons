{
  "$schema": "https://gen-animated-icons.lottiefiles.com/schema/icon-v2.json",
  "format": "gai-icon/2",
  "id": "model-picker",
  "label": "Model picker",
  "intent": "Choose the second model. Light: the selection chevron drops 14 units to the second option and lands with a hit and a small rebound, then clicks it: the chevron pokes in and the option is pushed back a step and settles. Strong: the chevron lifts first, dives, knocks twice, and the click pushes the option further with a recoil. The chevron stays at the second option. The reverse climbs back to the first option and clicks it the same way.",
  "state": {"from": "first-model", "to": "second-model", "labels": ["Choose", "Revert"], "reverse": "auto"},
  "parts": {
    "option-top": {"shape": {"rect": [11, 5, 15, 8], "r": 2}, "role": "surface", "solid": "ring"},
    "option-bottom": {"shape": {"rect": [11, 19, 15, 8], "r": 2}, "role": "surface", "solid": "ring"},
    "top-label": {"shape": {"line": [[16, 9], [21, 9]]}},
    "bottom-label": {"shape": {"line": [[16, 23], [21, 23]]}},
    "cursor": {"shape": {"polyline": [[5, 7], [7, 9], [5, 11]]}}
  },
  "rigs": {
    "pick-a": {"//": "the first option and its label take the click together", "pivot": [18.5, 9], "carries": ["option-top", "top-label"]},
    "pick-b": {"pivot": [18.5, 23], "carries": ["option-bottom", "bottom-label"]}
  },
  "motion": {
    "cursor.y": {
      "light": [[0, 0], [0.28, 14, "hit"], [0.34, 13.4], [0.4, 14]],
      "strong": [[0, 0], [0.1, -1.2, "out"], [0.32, 14, "hit"], [0.38, 13], [0.44, 14, "hit"], [0.49, 13.7], [0.54, 14]]
    },
    "cursor.x": {
      "light": [[0, 0], [0.3, 0], [0.35, 1, "out"], [0.44, 0]],
      "strong": [[0, 0], [0.44, 0], [0.49, 1.2, "out"], [0.58, 0]]
    },
    "pick-b.x": {
      "light": [[0, 0], [0.32, 0], [0.37, 0.9, "out"], [0.48, 0]],
      "strong": [[0, 0], [0.46, 0], [0.51, 1.4, "out"], [0.59, -0.2], [0.66, 0]]
    }
  },
  "reverse": {
    "//": "back to the first model: the chevron climbs (strong: dips first) and lands, then clicks the first option; the second option stays still",
    "light": {
      "cursor.y": [[0, 14], [0.28, 0, "hit"], [0.34, 0.6], [0.4, 0]],
      "cursor.x": [[0, 0], [0.3, 0], [0.35, 1, "out"], [0.44, 0]],
      "pick-a.x": [[0, 0], [0.32, 0], [0.37, 0.9, "out"], [0.48, 0]],
      "pick-b.x": [[0, 0], [0.48, 0]]
    },
    "strong": {
      "cursor.y": [[0, 14], [0.1, 15.2, "out"], [0.32, 0, "hit"], [0.38, 1], [0.44, 0, "hit"], [0.49, 0.3], [0.54, 0]],
      "cursor.x": [[0, 0], [0.44, 0], [0.49, 1.2, "out"], [0.58, 0]],
      "pick-a.x": [[0, 0], [0.46, 0], [0.51, 1.4, "out"], [0.59, -0.2], [0.66, 0]],
      "pick-b.x": [[0, 0], [0.66, 0]]
    }
  }
}
