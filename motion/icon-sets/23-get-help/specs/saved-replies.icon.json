{
  "$schema": "https://gen-animated-icons.lottiefiles.com/schema/icon-v2.json",
  "format": "gai-icon/2",
  "id": "saved-replies",
  "label": "Saved replies",
  "intent": "A saved reply is sent in one click: a speech bubble with a lightning bolt. Light: the bolt zaps on, flashing in from small and swelling past full size, and the bubble hops as the reply posts, lands with a hit and settles. Strong: the bolt flickers on twice and swells bigger, and the bubble hops higher and lands with two bounces.",
  "parts": {
    "bubble": {
      "shape": {"polygon": [
        {"p": [4.5, 4.5], "r": 3.5},
        {"p": [27.5, 4.5], "r": 3.5},
        {"p": [27.5, 22.5], "r": 3.5},
        {"p": [12, 22.5], "r": 1},
        {"p": [4.5, 27.5], "r": 0.6}
      ]},
      "role": "surface",
      "knockout": ["bolt"]
    },
    "bolt": {
      "//": "a filled bolt, so its shape holds at every weight",
      "shape": {"polygon": [
        {"p": [19, 7.1], "r": 0.5},
        {"p": [10.7, 15.3], "r": 0.6},
        {"p": [15.8, 15.3], "r": 0.3},
        {"p": [13, 20.1], "r": 0.5},
        {"p": [21.3, 11.7], "r": 0.6},
        {"p": [16.2, 11.7], "r": 0.3}
      ]},
      "role": "fill"
    }
  },
  "rigs": {
    "bubble": {"//": "the bubble hops as the reply posts, carrying the bolt", "pivot": [16, 13.5], "carries": ["bubble", "bolt"]},
    "bolt": {"pivot": [16, 13.6]}
  },
  "motion": {
