  },
  "rigs": {
    "page": {"//": "the page lifts and lands on its bottom edge", "pivot": [16, 28], "carries": ["page", "fold", "q"]}
  },
  "motion": {
    "page.y": {
      "light": [[0, 0], [0.1, -1.5, "out"], [0.22, 0, "hit"], [0.28, -0.4], [0.33, 0, "hit"]],
      "strong": [[0, 0], [0.11, -1.9, "out"], [0.24, 0, "hit"], [0.3, -0.7], [0.35, 0, "hit"], [0.39, -0.2], [0.42, 0, "hit"]]
    },
    "page.rotate": {
      "strong": [[0, 0], [0.11, -4, "out"], [0.24, 0, "hit"]]
    },
    "q.draw": {
      "light": [[0, 1], [0.02, 0, "step"], [0.05, 0], [0.22, 1, "out"]],
      "strong": [[0, 1], [0.02, 0, "step"], [0.05, 0], [0.18, 1, "out"]]
    }
  }
