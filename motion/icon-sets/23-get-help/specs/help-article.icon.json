        {"p": [19, 5], "r": 0.3},
        {"p": [25, 11], "r": 0.3},
        {"p": [25, 28], "r": 2.5},
        {"p": [7, 28], "r": 2.5}
      ]},
      "role": "surface",
      "knockout": [{"part": "fold", "gap": 0.3}, "q"]
    },
    "fold": {"shape": {"polyline": [[19, 5], [19, 11], [25, 11]], "r": 2}},
    "q": {
