{
  "$schema": "https://gen-animated-icons.lottiefiles.com/schema/icon-v2.json",
  "format": "gai-icon/2",
  "id": "round-countdown",
  "label": "Round countdown",
  "intent": "The round runs out. Light: the crown button is pressed, the hand sweeps 270 degrees from twelve to nine o'clock and stops dead there, and the watch jolts once as time is up; the hand stays at nine. Strong: a harder press, a faster sweep, and the watch rings like an alarm, rocking about its hub through decaying swings. Reverse: the button is pressed again and the hand snaps back to twelve with a small jolt. The hand never leaves the hub and never overshoots its reading.",
  "state": {"from": "round-start", "to": "round-elapsed", "labels": ["Start round", "Reset round"], "reverse": "auto"},
  "parts": {
    "case": {"shape": {"circle": [[16, 17.5], 9.5]}, "role": "surface", "solid": "ring", "//": "v1 Solid is the ring at 2.6, hollow; the tint is v1's face"},
    "tab":  {"shape": {"line": [[13.5, 4.5], [18.5, 4.5]]}},
    "neck": {"shape": {"line": [[16, 4.5], [16, 8]]}},
    "hand": {"shape": {"line": [[16, 17.5], [16, 11.5]]}},
    "hub":  {"shape": {"circle": [[16, 17.5], 1.35]}, "role": "fill"}
  },
  "rigs": {
    "watch":  {"//": "the alarm rocks the whole watch about the hub, so the hand stays on it", "pivot": [16, 17.5], "carries": ["case", "button", "hand", "hub"]},
    "button": {"pivot": [16, 4.5], "carries": ["tab", "neck"]},
    "hand":   {"pivot": [16, 17.5]}
  },
  "motion": {
    "button.y": {
      "light":  [[0, 0], [0.05, 1, "hit"], [0.13, 0, "out"]],
      "strong": [[0, 0], [0.06, 1.3, "hit"], [0.16, 0, "out"]]
    },
    "hand.rotate": {
      "light":  [[0, 0], [0.07, 0], [0.42, 270, "hit"]],
      "strong": [[0, 0], [0.08, 0], [0.34, 270, "hit"]]
    },
    "watch.rotate": {
      "light":  [[0, 0], [0.42, 0], [0.47, 5, "out"], [0.54, -2], [0.6, 0]],
      "strong": [[0, 0], [0.34, 0], [0.38, 8, "out"], [0.43, -7], [0.48, 6], [0.53, -4], [0.58, 2.5], [0.64, -1.2], [0.7, 0]]
    }
  },
  "reverse": {
    "//": "written out: the automatic mirror would ring the alarm before the reset and press the button last",
    "light": {
      "button.y":     [[0, 0], [0.05, 1, "hit"], [0.13, 0, "out"]],
      "hand.rotate":  [[0, 270], [0.07, 270], [0.36, 0, "hit"]],
      "watch.rotate": [[0, 0], [0.36, 0], [0.4, -3, "out"], [0.46, 1], [0.52, 0]]
    },
    "strong": {
      "button.y":     [[0, 0], [0.06, 1.3, "hit"], [0.16, 0, "out"]],
      "hand.rotate":  [[0, 270], [0.08, 270], [0.3, 0, "hit"]],
      "watch.rotate": [[0, 0], [0.3, 0], [0.34, -4, "out"], [0.4, 2], [0.46, -0.8], [0.52, 0]]
    }
  },
  "preview": {"light": [0, 0.05, 0.15, 0.25, 0.35, 0.42, 0.47, 0.6], "strong": [0, 0.06, 0.16, 0.26, 0.34, 0.38, 0.43, 0.53]}
}
