{
  "$schema": "https://gen-animated-icons.lottiefiles.com/schema/icon-v2.json",
  "format": "gai-icon/2",
  "id": "save-offline",
  "label": "Save offline",
  "intent": "A file is kept on the device for offline use. Light: the arrow in the badge drops onto its base, its shaft shortening as it lands, and the arrowhead folds into a check; the badge dips under the landing and settles, and the check stays. Strong: a faster, harder landing; the badge dips deeper and settles in two beats. The reverse lifts the check back up into the arrow: the offline copy is removed.",
  "state": {"from": "online-only", "to": "available-offline", "labels": ["Save offline", "Remove download"]},
  "parts": {
    "ring": {"shape": {"circle": [[16, 16], 11.5]}, "role": "surface", "knockout": ["arrow", "base"]},
    "base": {"shape": {"line": [[11.5, 22], [20.5, 22]]}},
    "arrow": {
      "//": "one subpath: the shaft is drawn up and back down, so it can fold into the check",
      "shape": {
        "morph": [
          {"polyline": [[12.2, 14.2], [16, 18], [16, 9], [16, 18], [19.8, 14.2]]},
          {"polyline": [[11.6, 14.6], [14.6, 17.6], [14.6, 17.6], [14.6, 17.6], [20.6, 11.6]]}
        ],
        "by": "land"
      }
    }
  },
  "rigs": {"badge": {"pivot": [16, 16], "carries": ["ring", "base", "arrow"]}},
  "motion": {
    "land": {"light": [[0, 0], [0.2, 1, "inOut"]], "strong": [[0, 0], [0.15, 1, "in"]]},
    "badge.y": {
      "light": [[0, 0], [0.15, 0], [0.22, 0.9, "out"], [0.3, -0.2], [0.36, 0]],
      "strong": [[0, 0], [0.11, 0], [0.17, 1.4, "out"], [0.25, -0.45], [0.32, 0.15], [0.38, 0]]
    }
  },
  "reverse": {
    "light": {"land": [[0, 1], [0.22, 0, "inOut"]], "badge.y": [[0, 0], [0.22, 0]]},
    "strong": {"land": [[0, 1], [0.18, 0, "out"]], "badge.y": [[0, 0], [0.06, -0.8, "out"], [0.14, 0.2], [0.2, 0]]}
  }
}
