{
  "$schema": "https://gen-animated-icons.lottiefiles.com/schema/icon-v2.json",
  "format": "gai-icon/2",
  "id": "send-to-device",
  "label": "Send to device",
  "intent": "A file is sent to the phone. Light: the arrow winds back, shoots right into the phone and fades as it reaches the screen; the phone takes the delivery, recoiling and settling, a check draws on inside its screen and fades, and a fresh arrow slides back into place. Strong: a deeper wind-up and a faster send; the phone buzzes side to side as the check snaps on.",
  "parts": {
    "phone": {
      "shape": {"rect": [14.5, 4.5, 13, 23], "r": 3},
      "role": "surface",
      "knockout": ["speaker", {"part": "check", "gap": 0.6}]
    },
    "speaker": {"shape": {"line": [[19, 8.2], [23, 8.2]]}},
    "check": {
      "//": "hidden at rest: the delivery lands",
      "shape": {"polyline": [[18.3, 16.4], [20.3, 18.4], [23.7, 14.4]]},
      "hidden": true
    },
    "shaft": {"shape": {"line": [[4.5, 16], [10.5, 16]]}},
    "head": {"shape": {"polyline": [[7.7, 13.2], [10.5, 16], [7.7, 18.8]]}}
  },
  "rigs": {
    "phone": {"pivot": [21, 16], "carries": ["phone", "speaker", "check"]},
    "arrow": {"pivot": [7.5, 16], "carries": ["shaft", "head"]}
  },
  "motion": {
    "arrow.x": {
      "light": [[0, 0], [0.07, -0.8, "out"], [0.17, 5, "in"], [0.18, -2, "step"], [0.4, 0.25, "out"], [0.46, 0]],
      "strong": [[0, 0], [0.1, -1.2, "inOut"], [0.2, 5.5, "in"], [0.21, -2, "step"], [0.46, 0.35, "out"], [0.53, -0.1], [0.58, 0]]
    },
    "shaft.opacity": {
      "light": [[0, 1], [0.11, 1], [0.16, 0, "in"], [0.3, 0], [0.4, 1, "out"]],
      "strong": [[0, 1], [0.14, 1], [0.19, 0, "in"], [0.34, 0], [0.44, 1, "out"]]
    },
    "head.opacity": {"follow": "shaft.opacity"},
    "phone.x": {
      "light": [[0, 0], [0.15, 0], [0.21, 0.8, "out"], [0.28, -0.2], [0.34, 0]],
      "strong": [[0, 0], [0.19, 0], [0.25, 1.2, "out"], [0.31, -0.5], [0.36, 0.35], [0.41, -0.2], [0.46, 0.1], [0.5, 0]]
    },
    "check.opacity": {
      "light": [[0, 0], [0.18, 0], [0.19, 1, "step"], [0.46, 1], [0.56, 0, "in"]],
      "strong": [[0, 0], [0.21, 0], [0.22, 1, "step"], [0.56, 1], [0.66, 0, "in"]]
    },
    "check.draw": {
      "light": [[0, 1], [0.18, 0, "step"], [0.29, 1, "out"]],
      "strong": [[0, 1], [0.21, 0, "step"], [0.28, 1, "out"]]
    }
  }
