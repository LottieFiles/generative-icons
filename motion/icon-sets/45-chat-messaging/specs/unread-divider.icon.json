{
  "$schema": "https://gen-animated-icons.lottiefiles.com/schema/icon-v2.json",
  "format": "gai-icon/2",
  "id": "unread-divider",
  "label": "Unread divider",
  "intent": "The unread boundary is marked. Light: the divider lines wind in toward the centre marker as it hops up, the marker drops back into place with a hit, and the lines snap out of it to both sides while the messages above and below are nudged apart to make room. Strong: a short dip before a higher hop, a landing that bounces, lines that snap out past their ends and spring back, and a firmer push that settles in two beats.",
  "parts": {
    "upper-message": {
      "shape": {"rect": [7, 5, 18, 4], "r": 2},
      "role": "surface",
      "solid": "ring"
    },
    "divider-l": {
      "//": "drawn from the marker outward, so it winds in to the marker and snaps out from it",
      "shape": {"line": [[11, 16], [4.5, 16]]}
    },
    "unread-dot": {
      "shape": {"circle": [[16, 16], 1.6]},
      "role": "fill"
    },
    "divider-r": {
      "shape": {"line": [[21, 16], [27.5, 16]]}
    },
    "lower-message": {
      "shape": {"rect": [7, 24, 18, 4], "r": 2},
      "role": "surface",
      "solid": "ring"
    }
  },
