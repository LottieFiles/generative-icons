      "light": [[0, 0], [0.1, -3, "out"], [0.22, 0, "hit"], [0.27, -0.4], [0.32, 0]],
      "strong": [[0, 0], [0.04, 0.6, "out"], [0.14, -3.6, "out"], [0.27, 0, "hit"], [0.32, -0.8, "out"], [0.37, 0, "hit"], [0.42, -0.2], [0.46, 0]]
    },
    "divider-l.draw": {
      "light": [[0, 1], [0.1, 0.08, "in"], [0.22, 0.08], [0.34, 1, "out"]],
