{
  "$schema": "https://gen-animated-icons.lottiefiles.com/schema/icon-v2.json",
  "format": "gai-icon/2",
  "id": "required-field",
  "label": "Required field",
  "intent": "A form field is flagged as required. Light: the asterisk beside the field's label pops up to a larger size with a quick twist and snaps back, and a beat later the empty field below dips under the flag and springs back. Strong: the asterisk crouches, pops bigger with a wider twist, snaps back and pops once more, smaller; the field dips with each pop. The label and asterisk keep their places.",
  "anchors": {"star": [18.5, 7.8]},
  "parts": {
    "label": {"shape": {"line": [[5, 7.8], [11, 7.8]]}},
    "asterisk": {"//": "three strokes through one centre: a six-armed asterisk",
                 "shape": [{"line": [[18.5, 4.6], [18.5, 11]]},
                           {"line": [{"from": "star", "angle": -30, "len": 3.2}, {"from": "star", "angle": 150, "len": 3.2}]},
                           {"line": [{"from": "star", "angle": 30, "len": 3.2}, {"from": "star", "angle": 210, "len": 3.2}]}]},
    "field": {"shape": {"rect": [4, 15, 24, 12], "r": 3}, "role": "surface", "solid": "ring"}
  },
  "rigs": {
    "asterisk": {"pivot": "star"},
    "field": {"pivot": [16, 21]}
  },
  "motion": {
    "asterisk.scale": {
      "light":  [[0, 1], [0.11, 1.32, "out"], [0.22, 0.94, "in"], [0.3, 1.0]],
      "strong": [[0, 1], [0.07, 0.84, "out"], [0.18, 1.36, "out"], [0.28, 0.9, "hit"], [0.36, 1.16, "out"], [0.44, 0.97, "in"], [0.5, 1.0]]
    },
    "asterisk.rotate": {
      "light":  [[0, 0], [0.11, 30, "out"], [0.24, 0, "inOut"]],
      "strong": [[0, 0], [0.07, -8, "out"], [0.18, 40, "out"], [0.3, -6, "inOut"], [0.42, 0, "inOut"]]
    },
    "field.y": {
      "light":  [[0, 0], [0.12, 0], [0.18, 0.8, "hit"], [0.3, 0, "out"]],
      "strong": [[0, 0], [0.19, 0], [0.25, 1.0, "hit"], [0.33, 0, "out"], [0.37, 0], [0.42, 0.5, "hit"], [0.5, 0, "out"]]
    }
  }
}
