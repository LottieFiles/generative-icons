{
  "$schema": "https://gen-animated-icons.lottiefiles.com/schema/icon-v2.json",
  "format": "gai-icon/2",
  "id": "text-area",
  "label": "Text area",
  "intent": "A multi-line text area is resized taller. Light: the resize grip in the bottom corner is pulled down, the box's bottom edge follows it, and the line of text that was cut off writes in as the room opens. Strong: the grip is pressed, yanked down past the new size and springs back to it, and the hidden line snaps in. The top edge and the first two lines never move; the reverse pushes the grip back up and the third line is hidden again.",
  "state": {"from": "compact", "to": "expanded", "labels": ["Expand", "Shrink"], "reverse": "auto"},
  "parts": {
    "box": {"//": "the bottom edge travels with the grip",
            "shape": {"morph": [{"rect": [4, 5, 24, 16], "r": 3}, {"rect": [4, 5, 24, 22], "r": 3}], "by": "size"},
            "role": "surface", "solid": "ring"},
    "line-1": {"shape": {"line": [[8, 10], [24, 10]]}},
    "line-2": {"shape": {"line": [[8, 14.5], [18, 14.5]]}},
    "line-3": {"//": "cut off while compact", "shape": {"line": [[8, 19], [15.5, 19]]}, "hidden": true},
    "grip": {"//": "the resize handle in the bottom corner", "shape": {"polygon": [[25.3, 14.4], [25.3, 18.6], [21.1, 18.6]], "r": 0.6}, "role": "fill"}
  },
  "rigs": {
    "grip": {"pivot": [23.9, 17.2]}
  },
  "motion": {
