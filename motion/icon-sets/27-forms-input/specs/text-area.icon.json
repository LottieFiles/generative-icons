      "light":  [[0, 0], [0.07, 0], [0.34, 6, "inOut"]],
      "strong": [[0, 0], [0.09, 0], [0.28, 7.3, "out"], [0.37, 5.6, "inOut"], [0.44, 6.2, "inOut"], [0.5, 6, "inOut"]]
    },
    "size": {
      "light":  [[0, 0], [0.07, 0], [0.34, 1, "inOut"]],
      "strong": [[0, 0], [0.09, 0], [0.28, 1.2167, "out"], [0.37, 0.9333, "inOut"], [0.44, 1.0333, "inOut"], [0.5, 1, "inOut"]]
    },
    "grip.scale": {
      "light":  [[0, 1], [0.06, 1.15, "out"], [0.34, 1.15], [0.42, 1, "inOut"]],
      "strong": [[0, 1], [0.08, 1.28, "out"], [0.28, 1.28], [0.36, 0.92, "inOut"], [0.44, 1, "inOut"]]
    },
    "line-3.opacity": {
      "light":  [[0, 0], [0.22, 0], [0.23, 1]],
      "strong": [[0, 0], [0.22, 0], [0.23, 1]]
