{
  "$schema": "https://gen-animated-icons.lottiefiles.com/schema/icon-v2.json",
  "format": "gai-icon/2",
  "id": "password-strength",
  "label": "Password strength",
  "intent": "A password gets stronger. Light: one more masked character pops into the password field, then the strength meter under it fills from weak to strong: the second bar sweeps on and stops dead, then the third. Strong: the character snaps in bigger, each bar strikes on in a quick hit with a short pause between, and the field gives one small lift when the meter is full. The meter never overshoots; the reverse empties it and removes the character.",
  "state": {"from": "weak", "to": "strong", "labels": ["Strengthen", "Weaken"], "reverse": "auto"},
  "parts": {
    "field": {"shape": {"rect": [4, 6, 24, 12], "r": 3}, "role": "surface", "solid": "ring"},
    "dot-1": {"shape": {"circle": [[9, 12], 1.5]}, "role": "fill"},
    "dot-2": {"shape": {"circle": [[13.5, 12], 1.5]}, "role": "fill"},
    "dot-3": {"shape": {"circle": [[18, 12], 1.5]}, "role": "fill"},
    "dot-4": {"//": "hidden while weak: the character that makes it strong", "shape": {"circle": [[22.5, 12], 1.5]}, "role": "fill", "hidden": true},
    "bar-1": {"shape": {"line": [[5.25, 24.5], [9.75, 24.5]]}},
    "slot-2": {"//": "the empty meter, faint", "shape": {"line": [[13.75, 24.5], [18.25, 24.5]]}, "opacity": 0.3},
    "slot-3": {"shape": {"line": [[22.25, 24.5], [26.75, 24.5]]}, "opacity": 0.3},
    "bar-2": {"//": "hidden while weak: sweeps on over its slot", "shape": {"line": [[13.75, 24.5], [18.25, 24.5]]}, "hidden": true},
    "bar-3": {"shape": {"line": [[22.25, 24.5], [26.75, 24.5]]}, "hidden": true}
  },
  "rigs": {
    "dot-4": {"pivot": [22.5, 12]},
    "field": {"pivot": [16, 12], "carries": ["dot-1", "dot-2", "dot-3", "dot-4"]}
  },
  "motion": {
    "dot-4.opacity": {
      "light":  [[0, 0], [0.02, 0], [0.04, 1]],
      "strong": [[0, 0], [0.02, 0], [0.04, 1]]
    },
    "dot-4.scale": {
      "light":  [[0, 1], [0.01, 0.3, "step"], [0.02, 0.3], [0.1, 1.2, "out"], [0.17, 1, "inOut"]],
      "strong": [[0, 1], [0.01, 0.3, "step"], [0.02, 0.3], [0.08, 1.35, "out"], [0.14, 0.9, "inOut"], [0.2, 1, "inOut"]]
    },
    "bar-2.opacity": {
      "light":  [[0, 0], [0.14, 0], [0.15, 1]],
      "strong": [[0, 0], [0.2, 0], [0.21, 1]]
    },
    "bar-2.draw": {
      "light":  [[0, 1], [0.01, 0, "step"], [0.14, 0], [0.27, 1, "out"]],
      "strong": [[0, 1], [0.01, 0, "step"], [0.2, 0], [0.27, 1, "hit"]]
    },
    "bar-3.opacity": {
      "light":  [[0, 0], [0.27, 0], [0.28, 1]],
      "strong": [[0, 0], [0.33, 0], [0.34, 1]]
    },
    "bar-3.draw": {
      "light":  [[0, 1], [0.01, 0, "step"], [0.27, 0], [0.4, 1, "out"]],
      "strong": [[0, 1], [0.01, 0, "step"], [0.33, 0], [0.4, 1, "hit"]]
    },
    "field.y": {
      "strong": [[0, 0], [0.4, 0], [0.47, -0.9, "out"], [0.55, 0.15, "inOut"], [0.6, 0, "inOut"]]
    }
  },
  "reverse": {
    "//": "the meter drops back from right to left, then the last character is deleted; the field holds still",
    "light": {
      "bar-3.draw": [[0, 1], [0.1, 0, "in"], [0.11, 1, "step"]],
      "bar-3.opacity": [[0, 1], [0.09, 1], [0.1, 0]],
      "bar-2.draw": [[0, 1], [0.1, 1], [0.2, 0, "in"], [0.21, 1, "step"]],
      "bar-2.opacity": [[0, 1], [0.19, 1], [0.2, 0]],
      "dot-4.scale": [[0, 1], [0.2, 1], [0.29, 0.3, "in"], [0.3, 1, "step"]],
      "dot-4.opacity": [[0, 1], [0.27, 1], [0.29, 0]]
    },
    "strong": {
      "bar-3.draw": [[0, 1], [0.07, 0, "hit"], [0.08, 1, "step"]],
      "bar-3.opacity": [[0, 1], [0.065, 1], [0.07, 0]],
      "bar-2.draw": [[0, 1], [0.12, 1], [0.19, 0, "hit"], [0.2, 1, "step"]],
      "bar-2.opacity": [[0, 1], [0.185, 1], [0.19, 0]],
      "dot-4.scale": [[0, 1], [0.24, 1], [0.28, 1.2, "out"], [0.34, 0.3, "in"], [0.35, 1, "step"]],
      "dot-4.opacity": [[0, 1], [0.32, 1], [0.34, 0]],
      "field.y": [[0, 0], [0.34, 0]]
    }
  }
}
