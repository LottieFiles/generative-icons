  "id": "product-tag",
  "label": "Product tag",
  "intent": "The tag is flicked and swings on its eyelet. Light: a tap lands under the free end (a small burst), the tag swings up about the eyelet, falls back past rest and settles. Strong: the finger presses the end down first, then flicks it harder; the tag swings higher, swings through twice and settles. The tag stays rigid; the eyelet is the pivot.",
  "parts": {
    "tag":    {"shape": {"path": "M7 12 L22 12 C22.5 12 23 12.2 23.4 12.6 L26.2 16.4 C26.9 17.1 26.9 18.9 26.2 19.6 L23.4 23.4 C23 23.8 22.5 24 22 24 L7 24 C6.2 24 5.5 23.3 5.5 22.5 L5.5 13.5 C5.5 12.7 6.2 12 7 12 Z"},
               "role": "surface", "knockout": [{"part": "eyelet", "gap": 0}]},
    "eyelet": {"shape": {"circle": [[21, 18], 2.2]}, "solid": "fill"},
    "tap-l":  {"//": "hidden at rest: the tap that sets the tag swinging, under its free end", "shape": {"line": [[5.8, 25.8], [4.7, 27.5]]}, "hidden": true},
    "tap-r":  {"mirror": {"of": "tap-l", "x": 7.2}}
  },
  "rigs": {
