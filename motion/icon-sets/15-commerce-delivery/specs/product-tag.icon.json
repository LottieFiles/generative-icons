      "strong": [[0, 0], [0.08, -3, "inOut"], [0.11, -3], [0.24, 20, "out"], [0.42, -8, "inOut"], [0.57, 3, "inOut"], [0.69, -1, "inOut"], [0.78, 0, "inOut"]]
