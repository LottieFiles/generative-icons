{
  "$schema": "https://gen-animated-icons.lottiefiles.com/schema/icon-v2.json",
  "format": "gai-icon/2",
  "id": "transit-stop",
  "label": "Transit stop",
  "intent": "The next bus pulls in to the stop. Light: the bus pulls away to the right and fades, the next one rolls in from the left, decelerates to a stop at its place, and its body dips 7° onto its front wheel and rocks back to rest. Strong: it comes in faster and brakes harder with a short overrun, the body dipping 10° and rocking back in two beats. The sign, post and ground never move.",
  "preview": {"light": [0, 0.07, 0.12, 0.17, 0.23, 0.29, 0.35, 0.42], "strong": [0, 0.06, 0.1, 0.15, 0.21, 0.28, 0.36, 0.43]},
  "parts": {
    "ground": {"shape": {"line": [[8, 27.5], [24, 27.5]]}},
    "post":   {"shape": {"line": [[16, 16.5], [16, 27.5]]}},
    "bus-2":  {"shape": {"circle": [[18.2, 13.3], 1]}, "role": "fill"},
    "bus-1":  {"shape": {"circle": [[13.8, 13.3], 1]}, "role": "fill"},
    "bus-0":  {"shape": {"rect": [11.5, 8, 9, 4.8], "r": 1.2}, "role": "fill"},
    "sign":   {"shape": {"rect": [7.5, 4.6, 17, 12], "r": 2}, "role": "surface", "solid": "ring"}
  },
  "rigs": {
    "bus":   {"//": "the whole bus travels in the sign", "carries": ["bus-0", "bus-1", "bus-2"]},
    "bus-0": {"//": "the body dips onto its front wheel when it brakes", "pivot": [18.2, 13.3]}
  },
  "motion": {
    "bus.x": {
      "light":  [[0, 0], [0.11, 2.2, "in"], [0.12, -2.6, "step"], [0.34, 0, "out"]],
      "strong": [[0, 0], [0.09, 2.4, "in"], [0.1, -2.6, "step"], [0.27, 0.6, "out"], [0.36, 0]]
    },
    "bus-0.opacity": {
      "light":  [[0, 1], [0.05, 1], [0.11, 0, "in"], [0.13, 0], [0.22, 1, "out"]],
      "strong": [[0, 1], [0.04, 1], [0.09, 0, "in"], [0.11, 0], [0.19, 1, "out"]]
    },
    "bus-1.opacity": {"follow": "bus-0.opacity"},
    "bus-2.opacity": {"follow": "bus-0.opacity"},
    "bus-0.rotate": {
      "light":  [[0, 0], [0.24, 0], [0.34, 7, "out"], [0.42, -1.5], [0.49, 0]],
      "strong": [[0, 0], [0.2, 0], [0.28, 10, "out"], [0.36, -3], [0.43, 1], [0.5, -0.3], [0.57, 0]]
    }
