{
  "$schema": "https://gen-animated-icons.lottiefiles.com/schema/icon-v2.json",
  "format": "gai-icon/2",
  "id": "video-doorbell",
  "label": "Video doorbell",
  "intent": "A visitor rings. Light: the ring button is pressed in, the chime sounds as a pair of arcs that flick out beside the button and fade as they spread, and the button springs back with a small overshoot. Strong: ding-dong: a deeper press, two chimes in turn, the second wider, and the camera wakes as the lens pupil opens wide, holds and closes again. The doorbell housing never moves.",
  "preview": {"light": [0, 0.07, 0.12, 0.18, 0.24, 0.3, 0.36, 0.4], "strong": [0, 0.08, 0.14, 0.22, 0.36, 0.46, 0.56, 0.66]},
  "parts": {
    "body":    {"shape": {"rect": [9.7, 3.8, 12.6, 24.4], "r": 6.3}, "role": "surface", "solid": "ring"},
    "lens":    {"shape": {"circle": [[16, 10.1], 2.5]}},
    "pupil":   {"shape": {"circle": [[16, 10.1], 0.55]}, "role": "fill"},
    "button":  {"shape": {"circle": [[16, 21.6], 3.2]}, "role": "surface", "solid": "ring"},
    "chime-r": {"//": "hidden at rest: the chime only exists while it sounds; centred on the button, kept 1.4 inside the canvas at full spread",
                "shape": {"arc": [[16, 21.6], 10.5, -25, 25]}, "hidden": true},
    "chime-l": {"mirror": {"of": "chime-r"}}
  },
  "motion": {
    "button.scale": {
      "light":  [[0, 1], [0.07, 0.78, "hit"], [0.12, 0.78], [0.2, 1.05], [0.28, 1]],
      "strong": [[0, 1], [0.08, 0.7, "hit"], [0.16, 0.7], [0.24, 1.08], [0.32, 0.97], [0.4, 1]]
    },
    "chime-r.opacity": {
      "light":  [[0, 0], [0.09, 0], [0.12, 1, "out"], [0.24, 1], [0.36, 0, "in"]],
      "strong": [[0, 0], [0.1, 0], [0.13, 1, "out"], [0.22, 1], [0.3, 0, "in"], [0.32, 0], [0.35, 1, "out"], [0.46, 1], [0.58, 0, "in"]]
    },
    "chime-r.r": {
      "light":  [[0, 0], [0.09, 0], [0.36, 1.5, "out"], [0.38, 0, "step"]],
      "strong": [[0, 0], [0.1, 0], [0.3, 1.3, "out"], [0.32, 0, "step"], [0.58, 2, "out"], [0.6, 0, "step"]]
    },
    "chime-l.opacity": {"follow": "chime-r.opacity"},
    "chime-l.r": {"follow": "chime-r.r"},
    "pupil.r": {
      "//": "the pupil opens from r 0.55 to 1.15 as the camera wakes, clear of the lens ring at Bold",
      "strong": [[0, 0], [0.14, 0], [0.22, 0.6, "out"], [0.5, 0.6], [0.62, 0, "inOut"]]
    }
  }
}
