  "id": "mic-access",
  "label": "Mic access",
  "intent": "Microphone access is granted and the microphone goes live. Light: the badge squeezes as its check lifts away, then pops as the check draws back on; a beat later a pair of sound arcs travels in from the upper sides and fades into the capsule, which dips as it hears it. Strong: a deeper squeeze and a bigger pop that bounces once, then two sounds arrive in turn and the capsule takes two hits, the second harder.",
  "parts": {
    "cradle": {"shape": {"path": "M4.5 11.5 L4.5 12 C4.5 15.31 7.19 18 10.5 18 C13.81 18 16.5 15.31 16.5 12 L16.5 11.5"}},
    "stand": {"shape": {"line": [[10.5, 18], [10.5, 21.5]]}},
    "foot": {"shape": {"line": [[8, 21.5], [13, 21.5]]}},
    "capsule": {"shape": {"rect": [7.75, 4.75, 5.5, 10], "r": 2.75}, "role": "surface"},
    "badge": {"//": "the permission: a check in a round badge", "shape": {"circle": [[22.6, 22.6], 5.6]}, "role": "surface", "knockout": [{"part": "check", "gap": 0.3}]},
    "check": {"shape": {"polyline": [[20.3, 22.8], [21.95, 24.45], [24.9, 21.3]]}},
    "wave-l": {"//": "hidden at rest: sound reaching the microphone once it is live", "shape": {"arc": [[10.5, 9.75], 7.7, 198, 236]}, "hidden": true},
    "wave-r": {"mirror": {"of": "wave-l", "x": 10.5}}
