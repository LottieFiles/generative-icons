{
  "$schema": "https://gen-animated-icons.lottiefiles.com/schema/icon-v2.json",
  "format": "gai-icon/2",
  "id": "code-diff",
  "label": "Code diff",
  "intent": "A code diff is applied: a removed line is deleted and an added line is confirmed. Light: the line marked minus erases back into its minus like a backspace, the minus kicks as it empties, then the plus pops and settles; the deleted line stays gone. Strong: the minus line erases faster after a short hold, the minus kicks harder, a highlight flashes up behind the added line and fades, and the plus pops bigger and settles in two beats. The preview reset fades the deleted line back in.",
  "state": {"from": "prepared", "to": "result", "labels": ["Play action", "Reset preview"], "reverse": "fade"},
  "parts": {
    "panel":    {"shape": {"rect": [4, 5, 24, 22], "r": 3}, "role": "surface", "solid": "ring"},
    "glow":     {"//": "Strong only, hidden at rest: the added line's highlight", "shape": {"rect": [6.5, 16.5, 19, 7], "r": 2}, "role": "fill", "hidden": true},
    "minus":    {"shape": {"line": [[8, 12], [13, 12]]}},
    "del-text": {"//": "drawn from the minus outward, so draw erases it back toward the minus", "shape": {"line": [[17, 12], [24, 12]]}},
    "plus":     {"shape": [{"line": [[8, 20], [13, 20]]}, {"line": [[10.5, 17.5], [10.5, 22.5]]}]},
    "add-text": {"shape": {"line": [[17, 20], [24, 20]]}}
  },
  "rigs": {
    "plus":  {"pivot": [10.5, 20]},
    "minus": {"pivot": [10.5, 12]}
  },
  "motion": {
    "del-text.draw": {
      "light":  [[0, 1], [0.04, 1], [0.22, 0, "in"]],
      "strong": [[0, 1], [0.1, 1], [0.22, 0, "in"]]
    },
    "del-text.opacity": {
      "light":  [[0, 1], [0.22, 1], [0.23, 0, "step"]],
      "strong": [[0, 1], [0.22, 1], [0.23, 0, "step"]]
    },
    "minus.x": {
      "light":  [[0, 0], [0.22, 0], [0.27, -0.6, "out"], [0.34, 0.15, "inOut"], [0.4, 0, "inOut"]],
      "strong": [[0, 0], [0.22, 0], [0.26, -0.9, "out"], [0.33, 0.3, "inOut"], [0.39, -0.08, "inOut"], [0.45, 0, "inOut"]]
    },
    "plus.scale": {
      "light":  [[0, 1], [0.28, 1], [0.34, 1.3, "out"], [0.42, 0.95, "inOut"], [0.48, 1, "inOut"]],
      "strong": [[0, 1], [0.36, 1], [0.42, 1.4, "out"], [0.5, 0.92, "inOut"], [0.57, 1.05, "inOut"], [0.63, 1, "inOut"]]
    },
    "glow.opacity": {
      "strong": [[0, 0], [0.24, 0], [0.3, 0.35, "out"], [0.44, 0.35], [0.6, 0, "in"]]
    }
  },
  "reverse": {
    "//": "only the deleted line changes; the panel, the markers and the added line end at rest and stay visible",
    "light":  {"panel.opacity": [[0, 1], [0.25, 1]], "minus.opacity": [[0, 1], [0.25, 1]], "plus.opacity": [[0, 1], [0.25, 1]], "add-text.opacity": [[0, 1], [0.25, 1]]},
    "strong": {"panel.opacity": [[0, 1], [0.25, 1]], "minus.opacity": [[0, 1], [0.25, 1]], "plus.opacity": [[0, 1], [0.25, 1]], "add-text.opacity": [[0, 1], [0.25, 1]]}
  }
}
