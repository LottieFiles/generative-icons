      "strong": [[0, 0], [0.05, -1.5, "in"], [0.255, -2, "step"], [0.27, 0, "linear"], [0.33, 1.6, "out"], [0.41, -0.45, "inOut"], [0.48, 0.15, "inOut"], [0.55, 0, "inOut"]]
