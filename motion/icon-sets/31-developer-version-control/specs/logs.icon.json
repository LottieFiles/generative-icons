{
  "$schema": "https://gen-animated-icons.lottiefiles.com/schema/icon-v2.json",
  "format": "gai-icon/2",
  "id": "logs",
  "label": "Logs",
  "intent": "A new entry streams into the log. Light: the log lines scroll up one row, the oldest line fading out at the top, and the new entry's timestamp pops in at the bottom while its message types out after it. Strong: the lines scroll up with a hit and a small rebound, the new timestamp blinks twice like a live indicator and the message types out faster. The new entry stays until the preview reset.",
  "state": {"from": "prepared", "to": "result", "labels": ["Play action", "Reset preview"], "reverse": "fade"},
  "parts": {
    "panel":  {"shape": {"rect": [4, 5, 24, 22], "r": 3}, "role": "surface", "solid": "ring"},
    "ts-1":   {"shape": {"line": [[8, 10.5], [10.5, 10.5]]}},
    "msg-1":  {"shape": {"line": [[14.5, 10.5], [24, 10.5]]}},
    "ts-2":   {"shape": {"line": [[8, 16], [10.5, 16]]}},
    "msg-2":  {"shape": {"line": [[14.5, 16], [21, 16]]}},
    "ts-3":   {"shape": {"line": [[8, 21.5], [10.5, 21.5]]}},
    "msg-3":  {"shape": {"line": [[14.5, 21.5], [23, 21.5]]}},
    "ts-new": {"//": "hidden at rest: the new entry, drawn where it lands in the bottom row", "shape": {"line": [[8, 21.5], [10.5, 21.5]]}, "hidden": true},
    "msg-new": {"shape": {"line": [[14.5, 21.5], [20, 21.5]]}, "hidden": true}
  },
  "rigs": {
    "scroll": {"pivot": [16, 16], "carries": ["ts-1", "msg-1", "ts-2", "msg-2", "ts-3", "msg-3"]},
    "ts-new": {"pivot": [9.25, 21.5]}
  },
  "motion": {
    "//": "The oldest line is gone before it reaches the panel's top edge.",
    "scroll.y": {
      "light":  [[0, 0], [0.04, 0], [0.24, -5.5, "inOut"]],
      "strong": [[0, 0], [0.04, 0], [0.18, -5.5, "hit"], [0.23, -5.1, "out"], [0.29, -5.5, "inOut"]]
    },
    "ts-1.opacity": {
      "light":  [[0, 1], [0.06, 1], [0.15, 0, "out"]],
      "strong": [[0, 1], [0.05, 1], [0.12, 0, "out"]]
    },
    "msg-1.opacity": {"follow": "ts-1.opacity"},
    "ts-new.opacity": {
      "light":  [[0, 0], [0.22, 0], [0.26, 1, "out"]],
      "strong": [[0, 0], [0.18, 0], [0.21, 1, "out"], [0.27, 1], [0.3, 0.15, "in"], [0.34, 1, "out"], [0.4, 1], [0.43, 0.15, "in"], [0.47, 1, "out"]]
    },
    "ts-new.scale": {
      "light":  [[0, 1], [0.22, 1], [0.27, 1.3, "out"], [0.35, 1, "inOut"]],
      "strong": [[0, 1], [0.18, 1], [0.22, 1.45, "out"], [0.29, 1, "inOut"]]
    },
    "msg-new.opacity": {
      "light":  [[0, 0], [0.26, 0], [0.27, 1, "step"]],
      "strong": [[0, 0], [0.21, 0], [0.22, 1, "step"]]
    },
    "msg-new.draw": {
      "light":  [[0, 1], [0.26, 0, "step"], [0.44, 1, "out"]],
      "strong": [[0, 1], [0.21, 0, "step"], [0.33, 1, "out"]]
    }
  },
  "reverse": {
    "//": "the panel never changes, so it stays visible while the rows fade back",
    "light":  {"panel.opacity": [[0, 1], [0.25, 1]]},
    "strong": {"panel.opacity": [[0, 1], [0.25, 1]]}
  }
}
