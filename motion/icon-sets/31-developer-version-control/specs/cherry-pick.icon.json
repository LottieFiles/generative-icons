{
  "$schema": "https://gen-animated-icons.lottiefiles.com/schema/icon-v2.json",
  "format": "gai-icon/2",
  "id": "cherry-pick",
  "label": "Cherry-pick",
  "intent": "A commit is cherry-picked from one branch onto another. Light: a copy of the source commit's point lifts out of its ring, arcs down across to the other branch and lands in the empty tip ring with a hit; that branch dips under the weight, springs back and settles, and the picked commit stays. Strong: the source ring swells as it gives up the copy, the copy flies higher and lands harder, the tip ring pops bigger and the branch settles in two beats. The preview reset fades the copy back out.",
  "state": {"from": "prepared", "to": "result", "labels": ["Play action", "Reset preview"], "reverse": "fade"},
  "parts": {
    "src-lane-l": {"shape": {"line": [[3.5, 8.5], [7.7, 8.5]]}},
    "src-lane-r": {"shape": {"line": [[16.3, 8.5], [28.5, 8.5]]}},
    "src":        {"shape": {"circle": [[12, 8.5], 4.3]}},
    "src-point":  {"//": "the commit being picked; it stays", "shape": {"circle": [[12, 8.5], 1.7]}, "role": "fill"},
    "dst-lane":   {"shape": {"line": [[3.5, 22.5], [16.7, 22.5]]}},
    "dst":        {"//": "the target branch's empty tip ring", "shape": {"circle": [[21, 22.5], 4.3]}},
    "copy":       {"//": "hidden at rest: the picked copy, drawn where it lands; it leaves from the source point", "shape": {"circle": [[21, 22.5], 1.7]}, "role": "fill", "hidden": true}
  },
  "rigs": {
    "target": {"pivot": [21, 22.5], "carries": ["dst-lane", "dst"]},
    "src":    {"pivot": [12, 8.5]}
  },
  "motion": {
    "//": "The copy rides the target's dip after it lands, so its y keys repeat target.y from the landing on.",
    "copy.opacity": {
      "light":  [[0, 0], [0.02, 0], [0.03, 1, "step"]],
      "strong": [[0, 0], [0.08, 0], [0.09, 1, "step"]]
    },
    "copy.x": {
      "light":  [[0, 0], [0.02, -9, "step"], [0.04, -9], [0.32, 0, "linear"]],
      "strong": [[0, 0], [0.08, -9, "step"], [0.1, -9], [0.32, 0, "linear"]]
    },
    "copy.y": {
      "light":  [[0, 0], [0.02, -14, "step"], [0.13, -16.2, "out"], [0.32, 0, "in"], [0.38, 1.2, "out"], [0.46, -0.3, "inOut"], [0.54, 0, "inOut"]],
      "strong": [[0, 0], [0.08, -14, "step"], [0.17, -17.5, "out"], [0.32, 0, "in"], [0.38, 1.6, "out"], [0.46, -0.6, "inOut"], [0.54, 0.25, "inOut"], [0.62, 0, "inOut"]]
    },
    "target.y": {
      "light":  [[0, 0], [0.32, 0], [0.38, 1.2, "out"], [0.46, -0.3, "inOut"], [0.54, 0, "inOut"]],
      "strong": [[0, 0], [0.32, 0], [0.38, 1.6, "out"], [0.46, -0.6, "inOut"], [0.54, 0.25, "inOut"], [0.62, 0, "inOut"]]
    },
    "dst.scale": {
      "light":  [[0, 1], [0.32, 1], [0.37, 1.1, "out"], [0.45, 1, "in"]],
      "strong": [[0, 1], [0.32, 1], [0.37, 1.12, "out"], [0.45, 1, "in"], [0.5, 1.05, "out"], [0.56, 1, "in"]]
    },
    "src.scale": {
      "light":  [[0, 1], [0.03, 1], [0.09, 1.08, "out"], [0.17, 1, "in"]],
      "strong": [[0, 1], [0.08, 1.15, "out"], [0.11, 1.15], [0.18, 1, "in"], [0.23, 1.04, "out"], [0.28, 1, "in"]]
    }
  },
  "reverse": {
    "//": "only the copy is new at the end; the branches and the source end at rest, so they stay visible",
    "light":  {"src.opacity": [[0, 1], [0.25, 1]], "dst.opacity": [[0, 1], [0.25, 1]], "dst-lane.opacity": [[0, 1], [0.25, 1]]},
    "strong": {"src.opacity": [[0, 1], [0.25, 1]], "dst.opacity": [[0, 1], [0.25, 1]], "dst-lane.opacity": [[0, 1], [0.25, 1]]}
  }
}
