{
  "$schema": "https://gen-animated-icons.lottiefiles.com/schema/icon-v2.json",
  "format": "gai-icon/2",
  "id": "merge-conflict",
  "label": "Merge conflict",
  "intent": "The merge conflict is resolved. Light: the blocking slash at the junction retracts, a check draws on in its place, and the junction pops as the check lands, then settles. Strong: the branches and junction first shake against each other (the conflict), then the slash retracts, the check snaps on with a hit and the junction pops bigger and settles in two beats. The check holds until the preview reset.",
  "state": {"from": "prepared", "to": "result", "labels": ["Play action", "Reset preview"], "reverse": "fade"},
  "parts": {
    "mark":       {"//": "the blocking slash: the prepared state", "shape": {"polyline": [[14.1, 20.4], [16, 18.5], [17.9, 16.6]]}},
    "check":      {"//": "hidden at rest: v1's end-state mark, drawn on from its short arm", "shape": {"polyline": [[13.6, 18.6], [15.5, 20.4], [18.2, 17.1]]}, "hidden": true},
    "junction":   {"shape": {"circle": [[16, 18.5], 6.5]}},
    "lane-right": {"mirror": {"of": "lane-left"}},
    "lane-left":  {"shape": {"path": "M7 7 L7 10 C7 13 8.5 13.9 11.4 13.9"}}
  },
  "rigs": {
    "main": {"pivot": [16, 18.5], "carries": ["mark", "check", "junction", "lane-right", "lane-left"]}
  },
  "motion": {
    "main.x": {
      "strong": [[0, 0], {"wobble": 0.01, "amp": 1.3, "until": 0.22, "swings": 3}]
    },
    "mark.draw": {
      "light":  [[0, 1], [0.1, 0, "in"]],
      "strong": [[0, 1], [0.15, 1], [0.22, 0, "in"]]
    },
    "mark.opacity": {
      "light":  [[0, 1], [0.1, 1], [0.11, 0, "step"]],
      "strong": [[0, 1], [0.22, 1], [0.23, 0, "step"]]
    },
    "check.opacity": {
      "light":  [[0, 0], [0.1, 0], [0.11, 1, "step"]],
      "strong": [[0, 0], [0.22, 0], [0.23, 1, "step"]]
    },
    "check.draw": {
      "light":  [[0, 1], [0.1, 0, "step"], [0.24, 1, "out"]],
      "strong": [[0, 1], [0.22, 0, "step"], [0.31, 1, "hit"]]
    },
    "main.scale": {
      "light":  [[0, 1], [0.22, 1], [0.29, 1.08, "out"], [0.36, 0.98, "inOut"], [0.43, 1, "inOut"]],
      "strong": [[0, 1], [0.31, 1], [0.37, 1.13, "out"], [0.45, 0.96, "inOut"], [0.52, 1.03, "inOut"], [0.6, 1, "inOut"]]
    }
  },
  "reverse": {
    "//": "v1's reset swaps only the mark; the junction and lanes end at rest, so they stay visible",
    "light":  {"junction.opacity": [[0, 1], [0.25, 1]], "lane-left.opacity": [[0, 1], [0.25, 1]], "lane-right.opacity": [[0, 1], [0.25, 1]]},
    "strong": {"junction.opacity": [[0, 1], [0.25, 1]], "lane-left.opacity": [[0, 1], [0.25, 1]], "lane-right.opacity": [[0, 1], [0.25, 1]]}
  }
}
