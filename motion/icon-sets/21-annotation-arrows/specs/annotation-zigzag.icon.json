{
  "$schema": "https://gen-animated-icons.lottiefiles.com/schema/icon-v2.json",
  "format": "gai-icon/2",
  "id": "annotation-zigzag",
  "label": "Zigzag pointer",
  "intent": "A zigzag arrow writes from its source dot to the target. Light: the stroke writes on zig by zig from the dot, then the head opens at the tip. Strong: the dot presses as the pen lands, the zigzag writes fast while its zigs stretch and spring back, and the head snaps open past its angle and settles. The preview reset fades the arrow back to the dot.",
  "state": {"from": "prepared", "to": "result", "labels": ["Play action", "Reset preview"], "reverse": "fade"},
  "anchors": {"tip": [26, 7.2]},
  "parts": {
    "route": {
      "//": "hidden at rest: the zigzag writes on from the dot",
      "shape": {
        "morph": [
          {"polyline": [[6.5, 25], [14, 22.5], [8.5, 18], [17.5, 15], [12, 10.5], "tip"], "r": 0.8},
          {"polyline": [[6.5, 25], [15.4, 22.7], [7.4, 18.2], [18.9, 15.2], [10.9, 10.7], "tip"], "r": 0.8}
        ],
        "by": "flex"
      },
      "hidden": true
    },
    "barb-a": {"shape": {"line": ["tip", [21.75, 4.57]]}, "hidden": true},
    "barb-b": {"shape": {"line": ["tip", [23.37, 11.45]]}, "hidden": true},
    "origin": {"shape": {"circle": [[6.5, 25], 2.1]}, "role": "fill"}
  },
  "rigs": {
    "barb-a": {"pivot": "tip"},
    "barb-b": {"pivot": "tip"}
  },
  "motion": {
    "origin.scale": {
      "light": [[0, 1]],
      "strong": [[0, 1], [0.06, 0.78, "in"], [0.16, 1.1, "out"], [0.28, 1]]
    },
    "route.opacity": {
      "light": [[0, 0], [0.06, 1, "step"]],
      "strong": [[0, 0], [0.06, 1, "step"]]
    },
    "route.draw": {
      "light": [[0, 1], [0.06, 0, "step"], [1.0, 1, "inOut"]],
      "strong": [[0, 1], [0.06, 0, "step"], [0.5, 1, "out"]]
    },
    "flex": {
      "light": [[0, 0]],
      "strong": [[0, 0], [0.08, 0], [0.3, 1, "out"], [0.5, -0.4, "inOut"], [0.66, 0.12, "inOut"], [0.8, 0, "inOut"]]
    },
    "barb-a.opacity": {
      "light": [[0, 0], [1.0, 1, "step"]],
      "strong": [[0, 0], [0.5, 1, "step"]]
    },
    "barb-a.draw": {
      "light": [[0, 1], [1.0, 0, "step"], [1.24, 1, "out"]],
      "strong": [[0, 1], [0.5, 0, "step"], [0.6, 1, "out"]]
    },
    "barb-a.rotate": {
      "light": [[0, 0]],
      "strong": [[0, 0], [0.5, -20, "step"], [0.62, 10, "out"], [0.74, -4, "inOut"], [0.86, 0, "inOut"]]
    },
    "barb-b.opacity": {"follow": "barb-a.opacity"},
    "barb-b.draw": {"follow": "barb-a.draw"},
    "barb-b.rotate": {"follow": "barb-a.rotate", "scale": -1}
  },
  "reverse": {
    "//": "the reset fades only the written arrow; the source dot stays",
    "light": {"origin.opacity": [[0, 1], [0.28, 1]]},
    "strong": {"origin.opacity": [[0, 1], [0.28, 1]]}
  }
}
