      "strong": [[0, 0], [0.15, 2.8, "in"], [0.1667, 0, "step"]]
    },
    "flake.rotate": {
      "light":  [[0, 0], [0.1667, 16, "in"], [0.18, 0, "step"]],
      "strong": [[0, 0], [0.15, 24, "in"], [0.1667, 0, "step"]]
    },
    "next.y": {
      "//": "starts 2.8 above and floats down (Strong: the air lifts it once on the way)",
      "light":  [[0, 0], [0.12, -2.8, "step"], [0.1333, -2.8], [0.46, 0, "out"]],
      "strong": [[0, 0], [0.1, -2.8, "step"], [0.1167, -2.8], [0.27, -0.9, "out"], [0.37, -1.3], [0.62, 0, "out"]]
    },
    "next.x": {
