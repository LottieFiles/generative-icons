{
  "$schema": "https://gen-animated-icons.lottiefiles.com/schema/icon-v2.json",
  "format": "gai-icon/2",
  "id": "snowflake",
  "label": "Snowflake",
  "intent": "Snow falls. Light: the flake drops away, tumbling, and fades while the next flake fades in above it and floats down into its place, swaying on the way, and lands softly with one small swing. Strong: the flake drops away tumbling harder, and the next one drifts down along a side-to-side path, is lifted once by the air and sways twice before it settles into place. Both flakes stay rigid.",
  "preview": {"light": [0, 0.06, 0.12, 0.2, 0.26, 0.32, 0.4, 0.52], "strong": [0, 0.08, 0.14, 0.22, 0.32, 0.45, 0.56, 0.7]},
  "parts": {
    "flake-arms": {"//": "v1's three arms as one layer and its six branches as another, so a fade shows almost no overlaps",
      "shape": [
        {"line": [[26.5, 16], [5.5, 16]]},
        {"line": [[21.25, 25.093], [10.75, 6.907]]},
        {"line": [[10.75, 25.093], [21.25, 6.907]]}]},
    "flake-branches": {"shape": [
        {"polyline": [[23.34, 13.845], [21.4, 16], [23.34, 18.155]]},
        {"polyline": [[21.537, 21.279], [18.7, 20.677], [17.804, 23.435]]},
        {"polyline": [[14.196, 23.435], [13.3, 20.677], [10.463, 21.279]]},
        {"polyline": [[8.66, 18.155], [10.6, 16], [8.66, 13.845]]},
        {"polyline": [[10.463, 10.721], [13.3, 11.323], [14.196, 8.565]]},
        {"polyline": [[17.804, 8.565], [18.7, 11.323], [21.537, 10.721]]}]},
    "next-arms": {"//": "hidden at rest: the next flake of the snowfall, the same drawing; it hands back to the flake at rest, where the two are identical",
      "shape": [
        {"line": [[26.5, 16], [5.5, 16]]},
        {"line": [[21.25, 25.093], [10.75, 6.907]]},
        {"line": [[10.75, 25.093], [21.25, 6.907]]}],
      "hidden": true},
    "next-branches": {"shape": [
        {"polyline": [[23.34, 13.845], [21.4, 16], [23.34, 18.155]]},
        {"polyline": [[21.537, 21.279], [18.7, 20.677], [17.804, 23.435]]},
        {"polyline": [[14.196, 23.435], [13.3, 20.677], [10.463, 21.279]]},
