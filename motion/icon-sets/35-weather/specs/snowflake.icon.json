  "rigs": {
    "flake": {"//": "rigid, about its centre; the reach (11.75 at Bold) caps any shift at 2.8", "pivot": [16, 16], "carries": ["flake-arms", "flake-branches"]},
    "next": {"pivot": [16, 16], "carries": ["next-arms", "next-branches"]}
  },
  "motion": {
