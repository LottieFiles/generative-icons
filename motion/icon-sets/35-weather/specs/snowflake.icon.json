    "flake-branches.opacity": {"follow": "flake-arms.opacity"},
    "next-arms.opacity": {
      "light":  [[0, 0], [0.1333, 0], [0.25, 1, "out"], [0.46, 1], [0.47, 0, "step"]],
      "strong": [[0, 0], [0.1167, 0], [0.2333, 1, "out"], [0.62, 1], [0.63, 0, "step"]]
    },
    "next-branches.opacity": {"follow": "next-arms.opacity"}
  }
