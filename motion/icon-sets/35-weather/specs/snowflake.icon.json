      "strong": [[0, 0], [0.1, -30, "step"], [0.1167, -30], [0.25, 12, "out"], [0.38, -6], [0.51, 2.5], [0.62, 0]]
    },
    "flake-arms.opacity": {
      "//": "the flakes overlap for two frames only, both faint, so the snowfall never leaves an empty frame; shown again in the frame the next flake, landed on the same pixels, is hidden",
