{
  "$schema": "https://gen-animated-icons.lottiefiles.com/schema/icon-v2.json",
  "format": "gai-icon/2",
  "id": "bus",
  "label": "Bus",
  "intent": "The bus pulls up at your stop. Light: it rides up over a bump, then brakes: the body dives forward on its suspension with a hit while the tyres stay planted and compress, rebounds once and settles, and the headlamps blink as it stops. Strong: it rolls in over two bumps, brakes harder and rebounds twice, and the headlamps blink twice. The body is rigid; only the exposed tyres compress and extend.",
  "parts": {
    "tire-left":    {"shape": {"line": [[10, 25], [10, 27.5]]}},
    "tire-right":   {"shape": {"line": [[22, 25], [22, 27.5]]}},
    "mirror-left":  {"shape": {"line": [[7, 13], [4.5, 13]]}},
    "mirror-right": {"shape": {"line": [[25, 13], [27.5, 13]]}},
    "body":         {"shape": {"rect": [7, 5, 18, 20], "r": 3}, "role": "surface",
                     "knockout": [{"part": "windshield", "gap": 0}, {"part": "lamps", "gap": 0}]},
    "windshield":   {"shape": {"rect": [10.5, 8.5, 11, 6.5], "r": 1.5}, "solid": "fill"},
    "lamps":        {"//": "both headlamps as one part, so they blink together and cut one matte in Solid",
                     "shape": [{"line": [[11, 20], [11.01, 20]]}, {"line": [[21, 20], [21.01, 20]]}],
                     "solid": {"path": "M11 18.8 C11.663 18.8 12.2 19.337 12.2 20 C12.2 20.663 11.663 21.2 11 21.2 C10.337 21.2 9.8 20.663 9.8 20 C9.8 19.337 10.337 18.8 11 18.8 L21 18.8 C21.663 18.8 22.2 19.337 22.2 20 C22.2 20.663 21.663 21.2 21 21.2 C20.337 21.2 19.8 20.663 19.8 20 C19.8 19.337 20.337 18.8 21 18.8 L11 18.8 Z"}}
  },
  "rigs": {
    "bus":   {"pivot": [16, 15], "carries": ["body", "windshield", "lamps", "mirror-left", "mirror-right"]},
    "tires": {"//": "the tyres keep their contact on the road and follow the body's bottom edge", "pivot": [16, 27.5], "squash": {"base": 27.5, "widen": 0}, "carries": ["tire-left", "tire-right"]}
  },
  "motion": {
    "bus.y": {
      "light":  [[0, 0], [0.08, -0.6, "out"], [0.17, 1.3, "hit"], [0.27, -0.3], [0.35, 0.1], [0.41, 0]],
      "strong": [[0, 0], [0.07, -0.5, "out"], [0.14, 0.3], [0.21, -0.5], [0.3, 1.8, "hit"], [0.4, -0.45], [0.48, 0.25], [0.55, -0.1], [0.6, 0]]
    },
    "tires.squash": {"follow": "bus.y", "scale": -0.4, "offset": 1},
    "lamps.opacity": {
      "light":  [[0, 1], [0.17, 1], [0.18, 0, "step"], [0.25, 0], [0.26, 1, "step"]],
      "strong": [[0, 1], [0.3, 1], [0.31, 0, "step"], [0.37, 0], [0.38, 1, "step"], [0.43, 1], [0.44, 0, "step"], [0.5, 0], [0.51, 1, "step"]]
    }
  }
}
