{
  "$schema": "https://gen-animated-icons.lottiefiles.com/schema/icon-v2.json",
  "format": "gai-icon/2",
  "id": "event-reminder",
  "label": "Event reminder",
  "intent": "The reminder goes off: the bell on the calendar rings. Light: the bell swings out from the top of its dome, the clapper trails it, and a ring arc flicks out beside the bell on the open side of each of the first two swings and fades as it spreads; the swing decays to rest in smaller beats. Strong: a wind-up, a wider swing and a longer ring-down with three dings that alternate sides and fade. The calendar never moves.",
  "parts": {
    "leaf":    {"shape": {"rect": [5, 6, 22, 21], "r": 2.7}, "role": "surface", "solid": "ring"},
    "peg-l":   {"shape": {"line": [[11, 4], [11, 8]]}},
    "peg-r":   {"shape": {"line": [[21, 4], [21, 8]]}},
    "header":  {"shape": {"line": [[5.5, 11.5], [26.5, 11.5]]}},
    "wave-l":  {"//": "hidden at rest: the ring only exists while the bell sounds", "shape": {"arc": [[16, 16], 7, 170, 192]}, "hidden": true},
    "wave-r":  {"mirror": {"of": "wave-l"}},
    "bell":    {"shape": {"path": "M11.8 21.4 L11.8 18.6 C11.8 15.6 13.6 14.4 16 14.4 C18.4 14.4 20.2 15.6 20.2 18.6 L20.2 21.4 Z"}, "role": "surface", "solid": "fill"},
    "rim":     {"shape": {"line": [[10.6, 21.4], [21.4, 21.4]]}},
    "clapper": {"shape": {"circle": [[16, 23.7], 1]}, "role": "fill"}
  },
  "rigs": {
    "bell":    {"//": "the shell and its rim swing from the top of the dome", "pivot": [16, 14.4], "carries": ["bell", "rim"]},
    "clapper": {"//": "hangs from the same point and trails the shell", "pivot": [16, 14.4]}
  },
  "motion": {
    "bell.rotate": {
      "light":  [[0, 0], [0.09, -13, "out"], [0.21, 8], [0.31, -3.5], [0.4, 1.2], [0.47, 0]],
      "strong": [[0, 0], [0.05, 4, "out"], [0.15, -18, "out"], [0.28, 12], [0.4, -7], [0.5, 3.5], [0.59, -1.2], [0.66, 0]]
    },
    "clapper.rotate": {"follow": "bell.rotate", "lag": 0.05},
    "wave-l.opacity": {
      "//": "the left ding sounds while the bell's mouth swings right, so the arc never meets the shell",
      "light":  [[0, 0], [0.08, 0], [0.1, 1, "out"], [0.17, 1], [0.26, 0, "in"]],
      "strong": [[0, 0], [0.13, 0], [0.15, 1, "out"], [0.22, 1], [0.31, 0, "in"], [0.38, 0], [0.4, 0.75, "out"], [0.46, 0.75], [0.54, 0, "in"]]
    },
    "wave-l.r": {
      "light":  [[0, 0], [0.08, 0], [0.26, 1.2, "out"], [0.28, 0, "step"]],
      "strong": [[0, 0], [0.13, 0], [0.31, 1.2, "out"], [0.33, 0, "step"], [0.38, 0], [0.54, 1, "out"], [0.56, 0, "step"]]
    },
    "wave-r.opacity": {
      "light":  [[0, 0], [0.19, 0], [0.21, 0.8, "out"], [0.27, 0.8], [0.35, 0, "in"]],
      "strong": [[0, 0], [0.26, 0], [0.28, 0.9, "out"], [0.35, 0.9], [0.44, 0, "in"]]
    },
    "wave-r.r": {
      "light":  [[0, 0], [0.19, 0], [0.35, 1.1, "out"], [0.37, 0, "step"]],
      "strong": [[0, 0], [0.26, 0], [0.44, 1.2, "out"], [0.46, 0, "step"]]
    }
  }
}
