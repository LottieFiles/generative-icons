{
  "$schema": "https://gen-animated-icons.lottiefiles.com/schema/icon-v2.json",
  "format": "gai-icon/2",
  "id": "event-badge",
  "label": "Event badge",
  "intent": "The badge is shown at the door and its holder is recognised. Light: the badge is flicked up on its lanyard, the attendee's head pops at the top of the swing as they are recognised, and the badge swings back and settles. Strong: a small wind-up, a wider flick, the head pops harder and the shoulders lift with it a beat later, and the badge rocks to rest in decaying swings. The lanyard never moves; the card stays rigid.",
  "parts": {
    "strap-l":   {"shape": {"line": [[16, 9.6], [13.4, 4.2]]}},
    "strap-r":   {"mirror": {"of": "strap-l"}},
    "clip":      {"shape": {"rect": [14.2, 8.4, 3.6, 3], "r": 1.3}, "role": "fill"},
    "card":      {"shape": {"rect": [9, 11.4, 14, 13], "r": 1.8}, "role": "surface", "solid": "ring"},
    "head":      {"shape": {"circle": [[16, 15.9], 1.9]}, "role": "fill"},
    "shoulders": {"shape": {"path": "M12.3 21.5 C12.3 19.1 13.9 17.9 16 17.9 C18.1 17.9 19.7 19.1 19.7 21.5"}}
  },
  "rigs": {
    "card":      {"//": "the badge hangs from the lanyard's knot", "pivot": [16, 9.6], "carries": ["clip", "card", "head", "shoulders"]},
    "head":      {"//": "the head pops about its centre", "pivot": [16, 15.9]},
    "shoulders": {"//": "the shoulders lift from their base", "pivot": [16, 21.5]}
  },
  "motion": {
    "card.rotate": {
      "light":  [[0, 0], [0.11, -8, "out"], [0.25, 3.5], [0.35, -1], [0.43, 0]],
      "strong": [[0, 0], [0.06, 3, "out"], [0.17, -14, "out"], [0.31, 7.5], [0.43, -3.5], [0.53, 1.2], [0.61, 0]]
    },
    "head.scale": {
      "light":  [[0, 1], [0.08, 1], [0.15, 1.4, "out"], [0.24, 0.92], [0.31, 1]],
      "strong": [[0, 1], [0.13, 1], [0.2, 1.5, "out"], [0.29, 0.9], [0.36, 1.04], [0.42, 1]]
    },
    "shoulders.scale": {
      "light":  [[0, 1]],
      "strong": {"follow": "head.scale", "lag": 0.06, "scale": 0.36, "offset": 0.64}
    }
  }
}
