{
  "$schema": "https://gen-animated-icons.lottiefiles.com/schema/icon-v2.json",
  "format": "gai-icon/2",
  "id": "face-authentication",
  "label": "Face authentication",
  "intent": "The face is scanned and recognised. Light: a scan line appears at the top of the frame, sweeps down over the face and fades; as it finishes, the four corner brackets snap in onto the face (hit), rebound and settle. Strong: the scan sweeps down and back up, the brackets lock on harder with a bounce, and the face gives a small nod of acceptance.",
  "parts": {
    "bracket-tl": {"shape": {"path": "M6 12 L6 8.2 C6 6.8 6.8 6 8.2 6 L12 6"}},
    "bracket-tr": {"shape": {"path": "M20 6 L23.8 6 C25.2 6 26 6.8 26 8.2 L26 12"}},
    "bracket-bl": {"shape": {"path": "M12 26 L8.2 26 C6.8 26 6 25.2 6 23.8 L6 20"}},
    "bracket-br": {"shape": {"path": "M26 20 L26 23.8 C26 25.2 25.2 26 23.8 26 L20 26"}},
    "eye-l": {"shape": {"line": [[12.5, 12.6], [12.5, 14.2]]}},
    "eye-r": {"shape": {"line": [[19.5, 12.6], [19.5, 14.2]]}},
    "mouth": {"shape": {"path": "M20.078 17.402 C19.339 18.987 17.749 20 16 20 C14.251 20 12.661 18.987 11.922 17.402"}},
    "scan": {"//": "hidden at rest: the scan line only exists while it sweeps", "shape": {"line": [[9.5, 9], [22.5, 9]]}, "hidden": true}
  },
  "rigs": {
    "face": {"//": "the features nod together", "pivot": [16, 16], "carries": ["eye-l", "eye-r", "mouth"]}
  },
  "motion": {
    "scan.opacity": {
      "light":  [[0, 0], [0.05, 1, "out"], [0.2, 1], [0.27, 0, "in"]],
      "strong": [[0, 0], [0.05, 1, "out"], [0.38, 1], [0.45, 0, "in"]]
    },
    "scan.y": {
      "light":  [[0, 0], [0.27, 14, "inOut"], [0.29, 0, "step"]],
      "strong": [[0, 0], [0.22, 14, "inOut"], [0.45, 1, "inOut"], [0.47, 0, "step"]]
    },
    "bracket-tl.x": {
      "light":  [[0, 0], [0.22, 0], [0.3, 1.3, "hit"], [0.39, -0.25], [0.48, 0]],
      "strong": [[0, 0], [0.4, 0], [0.48, 1.7, "hit"], {"bounce": 0.58, "amp": 0.3}, [0.68, -0.35], [0.8, 0]]
    },
    "bracket-tl.y": {"follow": "bracket-tl.x"},
    "bracket-tr.x": {"follow": "bracket-tl.x", "scale": -1},
    "bracket-tr.y": {"follow": "bracket-tl.x"},
    "bracket-bl.x": {"follow": "bracket-tl.x"},
    "bracket-bl.y": {"follow": "bracket-tl.x", "scale": -1},
    "bracket-br.x": {"follow": "bracket-tl.x", "scale": -1},
    "bracket-br.y": {"follow": "bracket-tl.x", "scale": -1},
    "face.y": {
      "light":  [[0, 0]],
      "strong": [[0, 0], [0.5, 0], [0.58, 1, "out"], [0.7, -0.2], [0.8, 0]]
    }
  }
