{
  "$schema": "https://gen-animated-icons.lottiefiles.com/schema/icon-v2.json",
  "format": "gai-icon/2",
  "id": "candlestick-chart",
  "label": "Candlestick chart",
  "intent": "The latest price candle trades. Light: the right candle falls back to its open, then rallies: its body and high wick grow up from the open and stop dead on the close. Strong: the left candle trades first, then the right one falls back and rallies in two moves, a pause halfway and a second push that stops dead on the close. The axes and the low wicks never move; prices never overshoot.",
  "parts": {
    "axes":     {"shape": {"polyline": [[6, 5], [6, 26], [27, 26]]}},
    "low-1":    {"shape": {"line": [[12.5, 19], [12.5, 22.5]]}},
    "body-1":   {"shape": {"rect": [10, 12, 5, 7], "r": 1}, "role": "surface"},
    "high-1":   {"shape": {"line": [[12.5, 12], [12.5, 9]]}},
    "low-2":    {"shape": {"line": [[22, 16], [22, 20]]}},
    "body-2":   {"shape": {"rect": [19.5, 8.5, 5, 7.5], "r": 1}, "role": "surface"},
    "high-2":   {"shape": {"line": [[22, 8.5], [22, 5.5]]}}
  },
  "rigs": {
    "candle-1": {"//": "the body and high wick stretch up from the open (the body's bottom edge)",
                 "pivot": [12.5, 19], "squash": {"base": 19, "widen": 0}, "carries": ["body-1", "high-1"]},
    "candle-2": {"pivot": [22, 16], "squash": {"base": 16, "widen": 0}, "carries": ["body-2", "high-2"]}
  },
  "motion": {
    "candle-2.squash": {
      "light":  [[0, 1], [0.07, 0.25, "out"], [0.1, 0.25], [0.3, 1, "hit"]],
      "strong": [[0, 1], [0.1, 1], [0.16, 0.2, "out"], [0.19, 0.2], [0.3, 0.65, "hit"], [0.36, 0.65], [0.46, 1, "hit"]]
    },
    "candle-1.squash": {
      "strong": [[0, 1], [0.06, 0.35, "out"], [0.08, 0.35], [0.22, 1, "hit"]]
    }
  }
}
