    "split": {"light": [[0, 0], [0.12, 0], [0.36, 1, "hit"]], "strong": [[0, 0], [0.22, 0], [0.36, 1.07, "out"], [0.45, 0.98], [0.55, 1]]}
  },
  "reverse": {
