    "cut-r": {"//": "hidden at rest: the cut through the right boundary", "shape": {"line": [[19.9, 9.5], [19.9, 26]]}, "hidden": true},
    "token-2": {
      "shape": {"morph": [{"rect": [19.9, 14, 7.8, 10], "r": 1.4}, {"rect": [22.4, 14, 5.4, 10], "r": 1.4}], "by": "split"},
      "role": "surface",
      "solid": "fill"
    },
    "token-1": {
      "shape": {"morph": [{"rect": [12.1, 14, 7.8, 10], "r": 1.4}, {"rect": [13.3, 14, 5.4, 10], "r": 1.4}], "by": "split"},
      "role": "surface",
      "solid": "fill"
    },
    "token-0": {
      "shape": {"morph": [{"rect": [4.3, 14, 7.8, 10], "r": 1.4}, {"rect": [4.2, 14, 5.4, 10], "r": 1.4}], "by": "split"},
      "role": "surface",
      "solid": "fill"
    },
    "word": {"shape": {"line": [[6, 6.5], [26, 6.5]]}}
  },
  "motion": {
    "cut-l.draw": {"light": [[0, 1], [0.01, 0, "step"], [0.12, 1, "out"]], "strong": [[0, 1], [0.01, 0, "step"], [0.1, 1, "out"]]},
    "cut-l.opacity": {
      "light": [[0, 0], [0.01, 1, "step"], [0.14, 1], [0.24, 0, "in"]],
      "strong": [[0, 0], [0.01, 1, "step"], [0.22, 1], [0.32, 0, "in"]]
    },
    "cut-r.draw": {"light": [[0, 1], [0.01, 0, "step"], [0.12, 1, "out"]], "strong": [[0, 1], [0.1, 1], [0.11, 0, "step"], [0.2, 1, "out"]]},
    "cut-r.opacity": {
      "light": [[0, 0], [0.01, 1, "step"], [0.14, 1], [0.24, 0, "in"]],
