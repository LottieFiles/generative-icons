node_modules/
__pycache__/
*.pyc
.DS_Store
.env
.env.*
*.log
*.zip
# Rebuildable intermediate scenes and native output; distributed assets are tracked.
# Scoped to set roots on purpose: research-review/before/scenes/ baselines are read by verify.mjs.
motion/icon-sets/*/scenes/
motion/icon-sets/*/native/
# Per-developer review captures, screenshots and recordings are kept locally.
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.mp4
*.mov
*.webm
screenshots/
# npm pack output
*.tgz
# Local planning and unreleased product experiments. Never publish this directory.
.local/
# Explicit public-site output; never deploy prototype/ directly.
dist/

# Per-run report written by the verification server; the PASS proof is browser-verification.json.
motion/icon-sets/*/evidence/directed-browser-progress*.json

# Rust build output
/target/
# Release binaries copied into the npm platform packages
npm/platforms/*/bin/*
!npm/platforms/*/bin/.gitkeep
