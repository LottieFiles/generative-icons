{
  "name": "lottie-generative-icons",
  "version": "0.1.0",
  "private": true,
  "description": "Generative Animated Icons by LottieFiles: animated icons, ready to use and built to extend.",
  "scripts": {
    "setup": "npm ci --prefix motion",
    "dev": "python3 scripts/serve.py",
    "build:site": "python3 scripts/build-public-site.py",
    "test:distribution": "python3 -m unittest discover -s scripts -p test_public_site.py",
    "test": "npm --prefix motion run test:library && npm --prefix motion run test:harness && npm run test:tooling",
    "check:assets": "python3 scripts/audit-assets.py",
    "check:paint": "npm --prefix motion run verify:paint",
    "check:source": "npm --prefix motion run icons:preflight -- --all",
    "docs:build": "python3 motion/icon-sets/library/build-guide.py",
    "package:icons": "python3 motion/icon-sets/library/package.py",
    "check:docs": "python3 scripts/check-docs.py",
    "doctor": "node motion/src/doctor.mjs",
    "icons:new": "python3 scripts/icon-set.py new",
    "icons:register": "python3 scripts/icon-set.py register",
    "test:tooling": "node --test motion/src/exporter-config.test.mjs && python3 -m unittest discover -s scripts -p test_icon_set.py",
    "build:packages": "python3 scripts/build-packages.py",
    "test:packages": "node --test tests/packages.test.mjs",
    "pack:release": "node scripts/pack-release.mjs",
    "test:consumers": "node scripts/test-consumers.mjs",
    "contribution:prepare": "python3 scripts/prepare-contribution.py"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ]
}
