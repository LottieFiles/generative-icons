{
  "$schema": "https://gen-animated-icons.lottiefiles.com/schema/icon-v2.json",
  "format": "gai-icon/2",
  "id": "in-room-safe",
  "label": "In-room safe",
  "intent": "Light: the dial turns half a turn, then the safe door swings open past square, uncovering the shelf and a gold bar. Strong: the dial spins past the mark, back and clicks onto it; the door pops, is flung against its stop and bounces. The reverse shuts the door and turns the dial back to locked.",
  "state": {"from": "locked", "to": "open", "labels": ["Unlock", "Lock"], "reverse": "auto"},
  "anchors": {"hinge": [7, 14.5], "dial": [16, 14]},
  "parts": {
    "body":    {"shape": {"rect": [7, 5.5, 18, 18], "r": 2.5}, "role": "surface", "solid": "ring"},
    "feet":    {"shape": [{"line": [[10.5, 23.5], [10.5, 26]]}, {"line": [[21.5, 23.5], [21.5, 26]]}]},
    "shelf":   {"shape": {"line": [[9.5, 13], [22.5, 13]]}},
    "bar":     {"shape": {"polygon": [[12.2, 21.4], [13.9, 17.6], [18.1, 17.6], [19.8, 21.4]], "r": 0.7},
                "role": "fill"},
    "door":    {"shape": {"rect": [7, 5.5, 18, 18], "r": 2.5}},
    "ring":    {"shape": {"circle": ["dial", 4.2]}},
    "pointer": {"shape": {"line": ["dial", [16, 12.6]]}}
  },
  "rigs": {
    "door":    {"swing": {"hinge": "hinge", "front": ["ring", "pointer"], "occludes": ["shelf", "bar"]},
                "carries": ["ring", "pointer"]},
    "pointer": {"pivot": "dial"}
  },
  "motion": {
    "door.swing": {
      "light":  [[0.46, 0], [1.02, 100, "out"]],
      "strong": [[0.6, 0], [0.78, 104, "hit"], {"settle": 1.12, "to": 100}]
    },
    "pointer.rotate": {
      "light":  [[0.06, 0], [0.46, 180, "inOut"]],
      "strong": [[0.03, 0], [0.28, 260], [0.46, 130], [0.6, 180]]
    }
  },
  "reverse": {
    "//": "Strong reverse: slam the door shut and hold it, then scramble the dial back past the mark.",
    "strong": {
      "door.swing":     [[0.04, 100], [0.26, 0, "hit"]],
      "pointer.rotate": [[0.3, 180], [0.62, -35], [0.76, 10], [0.86, 0]]
    }
  }
}
