{
  "$schema": "https://gen-animated-icons.lottiefiles.com/schema/icon-v2.json",
  "format": "gai-icon/2",
  "id": "alarm-clock",
  "label": "Alarm clock",
  "intent": "Light: one restrained outward strike of both bells. Strong: a small inward wind-up, a hard outward strike, and the whole clock tips 5.5° on its foot with the hit, undershoots once on the other foot and settles while the bells ring down.",
  "parts": {
    "body":   {"shape": {"circle": [[16, 17.5], 8.5]}, "role": "surface", "solid": "ring"},
    "minute": {"shape": {"line": [[16, 17.5], [16, 13]]}},
    "hour":   {"shape": {"line": [[16, 17.5], [19.3, 17.5]]}},
    "leg-l":  {"shape": {"line": [[12.2, 25.2], [10.6, 27.6]]}},
    "leg-r":  {"mirror": {"of": "leg-l"}},
    "bell-l": {"shape": {"arc": [[9.57, 11.07], 2.2, 135, 315], "closed": true}, "role": "surface", "tint": false},
    "bell-r": {"mirror": {"of": "bell-l"}}
  },
  "rigs": {
    "clock":  {"pivot": {"contact": ["leg-l.end", "leg-r.end"]},
               "carries": ["body", "minute", "hour", "leg-l", "leg-r", "bell-l", "bell-r"]},
    "bell-l": {"pivot": [10, 11.5]},
    "bell-r": {"pivot": [22, 11.5]}
  },
  "motion": {
    "bell-l.rotate": {
      "light":  [[0, 0], [0.1, -6], [0.42, 0, "inOut"]],
      "strong": [[0, 0], [0.07, 5], [0.17, -20, "hit"], [0.29, 13], [0.41, -7], [0.53, 3], [0.68, 0]]
    },
    "bell-r.rotate": {"follow": "bell-l.rotate", "scale": -1},
    "clock.rotate": {
      "strong": [[0, 0], [0.07, -1.3], [0.17, 5.5, "hit"], [0.33, -1.7], [0.48, 0.5], [0.66, 0]]
    }
  },
  "timing": {"light": 0.45, "strong": 0.7}
}
