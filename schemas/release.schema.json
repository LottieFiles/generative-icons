{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Icon release manifest v1",
  "type": "object",
  "required": ["schemaVersion", "version", "status", "sourceCommit", "sourceDirty", "runtimeVersion", "cliVersion", "playerVersion", "files"],
  "properties": {
    "schemaVersion": {"const": 1}, "version": {"type": "string"},
    "status": {"enum": ["release", "prerelease-dev"], "description": "release: built from a clean, committed source tree. prerelease-dev: built from uncommitted sources; never publish."},
    "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "sourceDirty": {"type": "boolean"},
    "runtimeVersion": {"type": "string"}, "cliVersion": {"type": "string"}, "playerVersion": {"type": "string"},
    "exporter": {"type": "object"},
    "inputs": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "files": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "packages": {"type": "array"}
  },
  "if": {"properties": {"status": {"const": "release"}}},
  "then": {"properties": {"sourceDirty": {"const": false}}}
}
